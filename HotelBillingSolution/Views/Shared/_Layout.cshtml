@using System.Globalization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotelBill</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- App CSS (single combined file: tokens + sidebar + dashboard + navbar dropdowns + device preview) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Theme must apply before first paint — inline here so there's no flash of the wrong theme *@
    <script>
            (function () {
                try {
                    var saved = localStorage.getItem("hb-theme");
                    var theme = saved || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                    document.documentElement.setAttribute("data-theme", theme);
                } catch (e) {
                    document.documentElement.setAttribute("data-theme", "light");
                }
            })();
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        // ActiveMenu is set by each controller/view via ViewBag.ActiveMenu, e.g. "Dashboard", "Rooms", ...
        string active = ViewBag.ActiveMenu as string ?? "";
        Func<string, string> navCls = (name) => active == name ? "hb-nav-link active" : "hb-nav-link";
    }
    <div class="hb-shell" id="hbShell">

        <!-- ============ SIDEBAR ============ -->
        <aside class="hb-sidebar" id="hbSidebar">

            <!-- Logo -->
            <div class="hb-logo">
                <a asp-controller="Home" asp-action="Index" class="hb-logo-icon" title="HotelBill">
                    <i class="fa-solid fa-building"></i>
                </a>
                <div class="hb-logo-text">
                    <span class="hb-logo-name">Hotel<span class="hb-brand-accent">Bill</span></span>
                    <span class="hb-logo-tag">Smart Hotel Billing</span>
                </div>
            </div>

            <!-- Nav -->
            <nav class="hb-nav">

                <div class="hb-nav-group">
                    <ul class="hb-nav-list">
                        <li>
                            <a asp-controller="Home" asp-action="Index" class="@navCls("Dashboard")" data-label="Dashboard">
                                <i class="fa-solid fa-table-cells-large"></i>
                                <span class="hb-nav-label">Dashboard</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="hb-nav-group">
                    <span class="hb-nav-heading">Hotel Management</span>
                    <ul class="hb-nav-list">
                        <li>
                            <a asp-controller="Rooms" asp-action="Index" class="@navCls("Rooms")" data-label="Rooms">
                                <i class="fa-solid fa-bed"></i>
                                <span class="hb-nav-label">Rooms</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Customer" asp-action="Index" class="@navCls("Customers")" data-label="Customers">
                                <i class="fa-solid fa-users"></i>
                                <span class="hb-nav-label">Customers</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Booking" asp-action="Index" class="@navCls("Bookings")" data-label="Bookings">
                                <i class="fa-solid fa-calendar-check"></i>
                                <span class="hb-nav-label">Bookings</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Housekeeping" asp-action="Index" class="@navCls("Housekeeping")" data-label="Housekeeping">
                                <i class="fa-solid fa-broom"></i>
                                <span class="hb-nav-label">Housekeeping</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Reports" asp-action="Index" class="@navCls("Reports")" data-label="Reports">
                                <i class="fa-solid fa-chart-column"></i>
                                <span class="hb-nav-label">Reports</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="hb-nav-group">
                    <span class="hb-nav-heading">Finance</span>
                    <ul class="hb-nav-list">
                        <li>
                            <a asp-controller="Billing" asp-action="Index" class="@navCls("Billing")" data-label="Billing">
                                <i class="fa-solid fa-receipt"></i>
                                <span class="hb-nav-label">Billing</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Payment" asp-action="Index" class="@navCls("Payments")" data-label="Payments">
                                <i class="fa-solid fa-credit-card"></i>
                                <span class="hb-nav-label">Payments</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Expense" asp-action="Index" class="@navCls("Expenses")" data-label="Expenses">
                                <i class="fa-solid fa-sack-dollar"></i>
                                <span class="hb-nav-label">Expenses</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="hb-nav-group">
                    <span class="hb-nav-heading">Others</span>
                    <ul class="hb-nav-list">
                        <li>
                            <a asp-controller="Settings" asp-action="Index" class="@navCls("Settings")" data-label="Settings">
                                <i class="fa-solid fa-gear"></i>
                                <span class="hb-nav-label">Settings</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="UsersRoles" asp-action="Index" class="@navCls("UsersRoles")" data-label="Users &amp; Roles">
                                <i class="fa-solid fa-user-shield"></i>
                                <span class="hb-nav-label">Users &amp; Roles</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Support" asp-action="Index" class="@navCls("Support")" data-label="Support Desk">
                                <i class="fa-solid fa-headset"></i>
                                <span class="hb-nav-label">Support Desk</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Alerts" asp-action="Index" class="@navCls("Alerts")" data-label="Alerts">
                                <i class="fa-solid fa-bell"></i>
                                <span class="hb-nav-label">Alerts</span>
                            </a>
                        </li>
                    </ul>
                </div>

            </nav>

            <!-- ============ SIDEBAR BOTTOM (fixed, never scrolls) ============ -->
            <div class="hb-sidebar-footer">
                <div class="hb-profile-card">
                    <img src="https://i.pravatar.cc/96?img=12" alt="Admin User" class="hb-profile-avatar" />
                    <div class="hb-profile-info">
                        <span class="hb-profile-name">Admin</span>
                        <span class="hb-profile-email">admin@hotelbill.com</span>
                        <span class="hb-profile-badge">SUPER ADMIN</span>
                    </div>
                    <div class="hb-profile-actions">
                        <a asp-controller="Settings" asp-action="Index" class="hb-profile-action-btn" title="Settings">
                            <i class="fa-solid fa-gear"></i>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="hb-logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="hb-profile-action-btn" title="Logout">
                                <i class="fa-solid fa-right-from-bracket"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Mobile / tablet overlay backdrop -->
        <div class="hb-overlay" id="hbOverlay"></div>

        <!-- Floating tooltip element used by site.js while sidebar is collapsed -->
        <div class="hb-tooltip" id="hbTooltip"></div>

        <!-- ============ MAIN ============ -->
        <div class="hb-main">

            <!-- ============ TOP NAVBAR ============ -->
            <header class="hb-navbar">
                <div class="hb-navbar-left">
                    <button class="hb-icon-btn hb-ripple" id="hbBurger" aria-label="Toggle sidebar" title="Toggle sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <div class="hb-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Search rooms, guests, invoices..." />
                    </div>
                </div>

                <div class="hb-navbar-right">
                    <button class="hb-date-btn hb-ripple" type="button">
                        <i class="fa-regular fa-calendar"></i>
                        <span>@DateTime.Now.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span>
                    </button>

                    <button class="hb-icon-btn hb-ripple" id="hbFullscreen" aria-label="Fullscreen" title="Fullscreen">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                    <!-- Device preview toggle: Tablet / Mobile only (Desktop removed — that's just the normal page) -->
                    <div class="hb-device-toggle" id="hbDeviceToggle">
                        <button type="button" class="hb-device-btn" data-device="tablet" title="Tablet">
                            <i class="fa-solid fa-tablet-screen-button"></i>
                        </button>
                        <button type="button" class="hb-device-btn" data-device="mobile" title="Mobile">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                        </button>
                    </div>

                    <button class="hb-icon-btn hb-theme-btn hb-ripple" id="hbThemeToggle" aria-label="Toggle theme" title="Switch to Dark Theme">
                        <i class="fa-solid fa-moon"></i>
                    </button>

                   

                    <!-- Notifications dropdown -->
                    <div class="hb-dropdown-wrap" id="hbNotifWrap">
                        <button class="hb-icon-btn hb-ripple" id="hbNotifBtn" aria-label="Notifications" title="Notifications">
                            <i class="fa-solid fa-bell"></i>
                            <span class="hb-badge">4</span>
                        </button>
                        <div class="hb-dropdown-panel" id="hbNotifPanel">
                            <div class="hb-dropdown-head">
                                <h6>Notifications</h6>
                                <a href="#">Mark all read</a>
                            </div>
                            <div class="hb-dropdown-sub">4 unread</div>
                            <div class="hb-dropdown-stats">
                                <div><strong>7</strong><span>Today</span></div>
                                <div><strong>23</strong><span>This Week</span></div>
                                <div><strong>3</strong><span>Approvals</span></div>
                            </div>

                            <div class="hb-dd-item">
                                <div class="hb-dd-icon blue"><i class="fa-solid fa-calendar-check"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">New Booking Confirmed</p>
                                    <p class="hb-dd-desc">Room 204 booked by Rohan Mehta for 3 nights</p>
                                    <div class="hb-dd-time">5m ago</div>
                                </div>
                                <div class="hb-dd-dot"></div>
                            </div>
                            <div class="hb-dd-item">
                                <div class="hb-dd-icon amber"><i class="fa-solid fa-broom"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Checkout Overdue</p>
                                    <p class="hb-dd-desc">Guest in Room 302 has not checked out yet</p>
                                    <div class="hb-dd-time">58m ago</div>
                                </div>
                                <div class="hb-dd-dot"></div>
                            </div>
                            <div class="hb-dd-item">
                                <div class="hb-dd-icon green"><i class="fa-solid fa-circle-check"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Payment Received</p>
                                    <p class="hb-dd-desc">Invoice #INV-3921 settled successfully</p>
                                    <div class="hb-dd-time">2h ago</div>
                                </div>
                            </div>
                            <div class="hb-dd-item">
                                <div class="hb-dd-icon red"><i class="fa-solid fa-triangle-exclamation"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Housekeeping Alert</p>
                                    <p class="hb-dd-desc">Room 108 flagged for maintenance check</p>
                                    <div class="hb-dd-time">3h ago</div>
                                </div>
                            </div>

                            <div class="hb-dropdown-foot"><a href="#">Open notification center &rarr;</a></div>
                        </div>
                    </div>

                    <!-- Emails dropdown -->
                    <div class="hb-dropdown-wrap" id="hbMailWrap">
                        <button class="hb-icon-btn hb-ripple" id="hbMailBtn" aria-label="Messages" title="Messages">
                            <i class="fa-solid fa-envelope"></i>
                            <span class="hb-badge">3</span>
                        </button>
                        <div class="hb-dropdown-panel" id="hbMailPanel">
                            <div class="hb-dropdown-head">
                                <h6>Emails</h6>
                                <a href="#">Mark all read</a>
                            </div>
                            <div class="hb-dropdown-sub">3 unread</div>

                            <div class="hb-dd-item">
                                <div class="hb-dd-icon blue"><i class="fa-solid fa-user"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Priya Sharma</p>
                                    <p class="hb-dd-desc">Inquiry about early check-in for Room 210</p>
                                    <div class="hb-dd-time">12m ago</div>
                                </div>
                                <div class="hb-dd-dot"></div>
                            </div>
                            <div class="hb-dd-item">
                                <div class="hb-dd-icon amber"><i class="fa-solid fa-building"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Acme Corporate Travel</p>
                                    <p class="hb-dd-desc">Requesting GST invoice for booking #B-2291</p>
                                    <div class="hb-dd-time">1h ago</div>
                                </div>
                                <div class="hb-dd-dot"></div>
                            </div>
                            <div class="hb-dd-item">
                                <div class="hb-dd-icon red"><i class="fa-solid fa-triangle-exclamation"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Sanjay Patil</p>
                                    <p class="hb-dd-desc">Complaint: AC not working in Room 115</p>
                                    <div class="hb-dd-time">4h ago</div>
                                </div>
                                <div class="hb-dd-dot"></div>
                            </div>

                            <div class="hb-dropdown-foot"><a href="#">Open inbox &rarr;</a></div>
                        </div>
                    </div>

                    <!-- Chat dropdown -->
                    <div class="hb-dropdown-wrap" id="hbChatWrap">
                        <button class="hb-icon-btn hb-ripple" id="hbChatBtn" aria-label="Chat" title="Chat">
                            <i class="fa-solid fa-comment-dots"></i>
                            <span class="hb-badge">2</span>
                        </button>
                        <div class="hb-dropdown-panel" id="hbChatPanel">
                            <div class="hb-dropdown-head">
                                <h6>Staff Chat</h6>
                                <a href="#">Mark all read</a>
                            </div>
                            <div class="hb-dropdown-sub">2 new messages</div>

                            <div class="hb-dd-item">
                                <div class="hb-dd-icon blue"><i class="fa-solid fa-concierge-bell"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Reception Desk</p>
                                    <p class="hb-dd-desc">Room 204 guest requesting extra towels</p>
                                    <div class="hb-dd-time">3m ago</div>
                                </div>
                                <div class="hb-dd-dot"></div>
                            </div>
                            <div class="hb-dd-item">
                                <div class="hb-dd-icon green"><i class="fa-solid fa-broom"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Housekeeping Team</p>
                                    <p class="hb-dd-desc">Room 310 cleaning completed</p>
                                    <div class="hb-dd-time">20m ago</div>
                                </div>
                                <div class="hb-dd-dot"></div>
                            </div>
                            <div class="hb-dd-item">
                                <div class="hb-dd-icon amber"><i class="fa-solid fa-user-tie"></i></div>
                                <div class="hb-dd-body">
                                    <p class="hb-dd-title">Front Office Manager</p>
                                    <p class="hb-dd-desc">VIP guest arriving 6 PM, prep Suite 501</p>
                                    <div class="hb-dd-time">1h ago</div>
                                </div>
                            </div>

                            <div class="hb-dropdown-foot"><a href="#">Open chat &rarr;</a></div>
                        </div>
                    </div>

                    <div class="hb-user-chip">
                        <img src="https://i.pravatar.cc/64?img=12" alt="Admin User" />
                        <div class="hb-user-chip-text">
                            <span class="hb-user-chip-name">Admin</span>
                            <span class="hb-user-chip-role">Super Admin</span>
                        </div>
                        <i class="fa-solid fa-chevron-down" style="font-size:10px;color:var(--text-faint);"></i>
                    </div>
                </div>
            </header>

            <!-- ============ PAGE CONTENT ============ -->
            <main class="hb-content">
                @RenderBody()
            </main>

            <footer class="hb-footer">
                <span>&copy; @DateTime.Now.Year HotelBill. All rights reserved.</span>
                <span>Crafted with <i class="fa-solid fa-heart hb-heart"></i> by Your Company</span>
            </footer>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js"></script>

    <!-- jQuery and jQuery validation (must be loaded before site scripts/unobtrusive validation) -->
    <script src="~/lib/jquery/dist/jquery.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>

    <!-- App JS (single combined file: theme switch + sidebar behavior + charts + device preview + navbar dropdowns) -->
    <script src="~/js/site.js" asp-append-version="true"></script>





    <div id="chatToggleBtn" onclick="toggleChat()" title="Hotel Assistant">
        <span class="chat-btn-icon">🤖</span>
        <span class="chat-btn-pulse"></span>
    </div>

    <!-- Chat Box -->
    <div id="chatBox" class="chatbot-box">
        <div class="chat-header">
            <div class="chat-header-info">
                <span class="chat-avatar">🤖</span>
                <div>
                    <div class="chat-title">Hotel Assistant</div>
                    <div class="chat-status"><span class="status-dot"></span> Online</div>
                </div>
            </div>
            <div class="chat-header-actions">
                <button onclick="clearChat()" title="Clear Chat" class="chat-action-btn">🗑️</button>
                <button onclick="toggleChat()" title="Close" class="chat-action-btn">✕</button>
            </div>
        </div>

        <div id="chatBody" class="chat-body">
            <div class="bot-msg-wrap">
                <span class="msg-avatar">🤖</span>
                <div class="bot-msg">Hi 👋 <b>@(User.Identity?.Name ?? "User")</b>, how can I help you?</div>
            </div>
        </div>

        <div id="typingIndicator" class="typing-indicator" style="display:none;">
            <span class="msg-avatar">🤖</span>
            <div class="typing-dots"><span></span><span></span><span></span></div>
        </div>

        <!-- ✅ NEW: Char counter + error message ABOVE input -->
        <div id="chatValidationArea">
            <div id="chatInputError" class="chat-error-msg" style="display:none;"></div>
            <div id="charCounter" class="char-counter" style="display:none;"></div>
        </div>

        <div class="chat-input-area">
            <input type="text" id="chatInput" placeholder="Ask anything..." autocomplete="off" maxlength="500" />
            <button onclick="sendMessage()" id="sendBtn" title="Send">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </div>

    <!-- Edit Modal -->
    <div id="editModal" class="edit-modal" style="display:none;">
        <div class="edit-modal-box">
            <div class="edit-modal-title">✏️ Edit Message</div>
            <textarea id="editInput" rows="3" maxlength="500"></textarea>
            <div id="editError" class="chat-error-msg" style="display:none;"></div>
            <div class="edit-modal-actions">
                <button onclick="cancelEdit()" class="btn-cancel">Cancel</button>
                <button onclick="confirmEdit()" class="btn-confirm">Send Edited</button>
            </div>
        </div>
    </div>

    <style>
        /* ── TOGGLE BUTTON ───────────────────────────────── */
        #chatToggleBtn {
        position: fixed;
        bottom: 28px;
        right: 28px;
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 9998;
        box-shadow: 0 4px 20px rgba(79,70,229,0.45);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        #chatToggleBtn:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 28px rgba(79,70,229,0.55);
        }

        .chat-btn-icon {
        font-size: 26px;
        }

        .chat-btn-pulse {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #22c55e;
        border: 2px solid white;
        }

        /* ── CHAT BOX ────────────────────────────────────── */
        .chatbot-box {
        position: fixed;
        bottom: 100px;
        right: 28px;
        width: 360px;
        max-height: 580px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 12px 48px rgba(0,0,0,0.18);
        display: flex;
        flex-direction: column;
        z-index: 9999;
        overflow: hidden;
        transform: scale(0.85) translateY(20px);
        opacity: 0;
        pointer-events: none;
        transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
        }

        .chatbot-box.open {
        transform: scale(1) translateY(0);
        opacity: 1;
        pointer-events: all;
        }

        [data-theme="dark"] .chatbot-box {
        background: #1e1e2e;
        box-shadow: 0 12px 48px rgba(0,0,0,0.45);
        }

        /* ── HEADER ─────────────────────────────────────── */
        .chat-header {
        background: linear-gradient(135deg,#4f46e5,#7c3aed);
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        }

        .chat-header-info {
        display: flex;
        align-items: center;
        gap: 10px;
        }

        .chat-avatar {
        font-size: 28px;
        }

        .chat-title {
        color: white;
        font-weight: 700;
        font-size: 15px;
        }

        .chat-status {
        color: rgba(255,255,255,0.8);
        font-size: 11px;
        display: flex;
        align-items: center;
        gap: 4px;
        }

        .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ade80;
        display: inline-block;
        }

        .chat-header-actions {
        display: flex;
        gap: 6px;
        }

        .chat-action-btn {
        background: rgba(255,255,255,0.15);
        border: none;
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        }

        .chat-action-btn:hover {
        background: rgba(255,255,255,0.28);
        }

        /* ── BODY ────────────────────────────────────────── */
        .chat-body {
        flex: 1;
        overflow-y: auto;
