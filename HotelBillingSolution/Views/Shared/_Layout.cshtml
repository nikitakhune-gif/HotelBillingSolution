    </style>

    <script>
        // ── Global Chat Variables ──────────────────────────────────────────────
        const VALIDATION = { maxLength: 500, rateLimitCount: 5, rateLimitMs: 5000 };
        let editingMsgEl = null;
        let isChatOpen = false;
        let frontendMsgTimes = [];
        let connection = null;

        // ── SignalR Connection ─────────────────────────────────────────────────
        // Check if signalR is available before using it
        if (typeof signalR !== 'undefined') {
        connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();

        // ── SignalR Events ─────────────────────────────────────────────────────
        connection.on("BotTyping", function (isTyping) {
        document.getElementById("typingIndicator").style.display = isTyping ? "flex" : "none";
        scrollToBottom();
        });

        connection.on("ReceiveMessage", function (response) {
        // If server sends structured object, handle fields
        if (typeof response === 'object') {
            if (response.text) appendBotMessage(response.text, false);
            if (response.table) appendBotMessage(renderTableFromArray(response.table), false);
            if (response.list) appendBotMessage(renderListFromArray(response.list), false);
        } else {
            appendBotMessage(response, false);
        }
        });

        // ✅ Server validation error → show in chat as red message
        connection.on("ValidationError", function (errorMsg) {
        appendBotMessage(errorMsg, true);
        showInputError(errorMsg);
        });

        connection.start().catch(err => console.error("SignalR Error:", err));
        }

        if (window.location.search.includes('preview=true')) {
        document.querySelector('.prev-btn[data-width="100%"]').click = null;
        document.querySelectorAll('.prev-btn').forEach(b => b.style.display = 'none');
        }

        var currentWidth = '100%';

        document.querySelectorAll('.prev-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
        document.querySelectorAll('.prev-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        var width = btn.getAttribute('data-width');
        currentWidth = width;

        if (width === '100%') {
        closePreview();
        return;
        }

        var overlay = document.getElementById('previewOverlay');
        var frame = document.getElementById('previewFrame');
        var label = document.getElementById('previewLabel');

        frame.src = window.location.href + '?preview=true';
        frame.style.width = width;
        frame.style.maxWidth = width;
        label.textContent = (width === '768px' ? 'Tablet' : 'Mobile') + ' Preview — ' + width;
        overlay.classList.add('active');
        });
        });

        function closePreview() {
        document.getElementById('previewOverlay').classList.remove('active');
        document.querySelectorAll('.prev-btn').forEach(b => b.classList.remove('active'));
        document.querySelector('.prev-btn[data-width="100%"]').classList.add('active');
        }
        function closePreview() {
        document.getElementById('previewOverlay').classList.remove('active');
        document.querySelectorAll('.prev-btn').forEach(b => b.classList.remove('active'));
        document.querySelector('.prev-btn[data-width="100%"]').classList.add('active');
        }

        function switchPreview(width) {
        var frame = document.getElementById('previewFrame');
        var label = document.getElementById('previewLabel');
        var tabletBtn = document.getElementById('previewTabletBtn');
        var mobileBtn = document.getElementById('previewMobileBtn');
        frame.style.width = width;
        frame.style.maxWidth = width;
        label.textContent = (width === '768px' ? 'Tablet' : 'Mobile') + ' Preview — ' + width;
        if (width === '768px') {
        tabletBtn.style.background = '#7F77DD';
        tabletBtn.style.color = '#fff';
        mobileBtn.style.background = 'transparent';
        mobileBtn.style.color = 'rgba(255,255,255,0.6)';
        } else {
        mobileBtn.style.background = '#7F77DD';
        mobileBtn.style.color = '#fff';
        tabletBtn.style.background = 'transparent';
        tabletBtn.style.color = 'rgba(255,255,255,0.6)';
        }
        document.querySelectorAll('.prev-btn').forEach(b => b.classList.remove('active'));
        var headerBtn = document.querySelector('.prev-btn[data-width="' + width + '"]');
        if (headerBtn) headerBtn.classList.add('active');
        }

 
        // ── Toggle Chat ────────────────────────────────────────────────────────
        function toggleChat() {
        const box = document.getElementById("chatBox");
        isChatOpen = !isChatOpen;
        box.classList.toggle("open", isChatOpen);
        if (isChatOpen) {
        setTimeout(() => document.getElementById("chatInput").focus(), 300);
        scrollToBottom();
        }
        }

        // ── FRONTEND VALIDATION ────────────────────────────────────────────────
        function validateMessage(msg) {
        // 1. Empty
        if (!msg || msg.trim().length === 0) {
        showInputError("⚠️ Please type a message before sending!");
        shakeInput();
        return false;
        }

        // 2. Max length
        if (msg.length > VALIDATION.maxLength) {
        showInputError(`⚠️ Too long! Maximum ${VALIDATION.maxLength} characters. (${msg.length}/${VALIDATION.maxLength})`);
        shakeInput();
        return false;
        }

        // 3. XSS check
        if (/<script|javascript:|onclick|onerror|<iframe|<img/i.test(msg)) {
        showInputError("⚠️ Invalid input detected!");
        shakeInput();
        return false;
        }

        // 4. Only symbols/spaces
        if (/^[^a-zA-Z0-9\u0900-\u097F]+$/.test(msg.trim())) {
        showInputError("⚠️ Please type a valid message!");
        shakeInput();
        return false;
        }

        // 5. Repeated chars (aaaa, zzzz)
        if (/(.)\1{4,}/.test(msg)) {
        showInputError("🤔 Please type a meaningful message!");
        shakeInput();
        return false;
        }

        // 6. Rate limit
        const now = Date.now();
        frontendMsgTimes = frontendMsgTimes.filter(t => now - t < VALIDATION.rateLimitMs);
        if (frontendMsgTimes.length >= VALIDATION.rateLimitCount) {
        showInputError("⏳ Slow down! Too many messages at once.");
        shakeInput();
        return false;
        }
        frontendMsgTimes.push(now);

        clearInputError();
        return true;
        }

        // ── Send Message (fallback to REST if SignalR not available)
        async function sendMessage(customMsg) {
        const input = document.getElementById("chatInput");
        const msg = customMsg !== undefined ? customMsg : input.value.trim();

        if (!validateMessage(msg)) return;

        appendUserMessage(msg);
        input.value = "";
        updateCharCount(0);

        // Show typing indicator
        document.getElementById('typingIndicator').style.display = 'flex';

        // First try SignalR
        if (connection) {
            try {
                await connection.invoke("SendMessage", msg);
                return;
            } catch (e) {
                console.warn('SignalR send failed, falling back to HTTP', e);
            }
        }

        // Fallback to HTTP POST /api/chat
        try {
            const res = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg })
            });
            document.getElementById('typingIndicator').style.display = 'none';
            if (!res.ok) {
                const err = await res.json().catch(() => null);
                appendBotMessage(err && err.error ? err.error : 'Server error', true);
                return;
            }
            const data = await res.json();
            // Render response: prefer text, then table/list
            if (data.text) appendBotMessage(data.text, false);
            if (data.table) {
                const html = renderTableFromArray(data.table);
                appendBotMessage(html, false);
            }
            if (data.list) {
                const html = renderListFromArray(data.list);
                appendBotMessage(html, false);
            }
        } catch (ex) {
            document.getElementById('typingIndicator').style.display = 'none';
            appendBotMessage('❌ Connection error. Please try again.', true);
        }
        }

        // ── Append User Message ────────────────────────────────────────────────
        function appendUserMessage(text) {
        const body = document.getElementById("chatBody");
        const wrap = document.createElement("div");
        wrap.className = "user-msg-wrap";
        wrap.innerHTML = `
        <div style="position:relative;">
        <div class="user-msg">${escapeHtml(text)}</div>
        <div class="msg-actions">
        <button class="msg-action-btn" onclick="editMessage(this,'${escapeForAttr(text)}')">✏️ Edit</button>
        <button class="msg-action-btn" onclick="copyMessage('${escapeForAttr(text)}')">📋 Copy</button>
        </div>
        </div>`;
        body.appendChild(wrap);
        scrollToBottom();
        }

        // ── Append Bot Message ─────────────────────────────────────────────────
        function appendBotMessage(text, isError) {
        const body = document.getElementById("chatBody");
        const formatted = text && typeof text === 'string' ? text.split('\n').join('<br>') : text;
        const wrap = document.createElement("div");
        wrap.className = "bot-msg-wrap";
        const msgClass = isError ? "bot-msg validation-bot-msg" : "bot-msg";
        wrap.innerHTML = `
        <span class="msg-avatar">${isError ? '⚠️' : '🤖'}</span>
        <div style="position:relative;">
        <div class="${msgClass}">${formatted}</div>
        ${!isError ? `
        <div class="msg-actions">
        <button class="msg-action-btn" onclick="copyMessage('${escapeForAttr(text)}')">📋 Copy</button>
        </div>
        <div class="feedback-wrap">
        <button class="feedback-btn" onclick="giveFeedback(this,'👍')">👍 Helpful</button>
        <button class="feedback-btn" onclick="giveFeedback(this,'👎')">👎 Not helpful</button>
        </div>` : ''}
        </div>`;
        body.appendChild(wrap);
        scrollToBottom();
        }

        function renderTableFromArray(arr) {
            try {
                if (!Array.isArray(arr) || arr.length === 0) return 'No data.';
                const keys = Object.keys(arr[0]);
                let html = '<div style="overflow:auto;max-width:320px;">';
                html += '<table style="width:100%;border-collapse:collapse;font-size:13px;">';
                html += '<thead><tr>' + keys.map(k => `<th style="text-align:left;padding:6px;border-bottom:1px solid #eee;">${k}</th>`).join('') + '</tr></thead>';
                html += '<tbody>' + arr.map(r => '<tr>' + keys.map(k => `<td style="padding:6px;border-bottom:1px solid #f3f4f6;">${escapeHtml(String(r[k] ?? ''))}</td>`).join('') + '</tr>').join('') + '</tbody>';
                html += '</table></div>';
                return html;
            } catch (e) { return 'Unable to render table'; }
        }

        function renderListFromArray(arr) {
            try {
                if (!Array.isArray(arr) || arr.length === 0) return 'No items.';
                return arr.map(i => '- ' + Object.values(i).map(v => escapeHtml(String(v))).join(' | ')).join('\n');
            } catch (e) { return 'Unable to render list'; }
        }

        // ── Show / Clear Input Error ───────────────────────────────────────────
        function showInputError(msg) {
        const input = document.getElementById("chatInput");
        const errEl = document.getElementById("chatInputError");
        input.classList.add("input-error");
        errEl.textContent = msg;
        errEl.style.display = "block";
        setTimeout(clearInputError, 3500);
        }

        function clearInputError() {
        const input = document.getElementById("chatInput");
        const errEl = document.getElementById("chatInputError");
        input.classList.remove("input-error");
        errEl.style.display = "none";
        errEl.textContent = "";
        }

        // ── Shake Input ────────────────────────────────────────────────────────
        function shakeInput() {
        const input = document.getElementById("chatInput");
        input.style.animation = "none";
        input.offsetHeight;
        input.style.animation = "shakeInput 0.4s ease";
        setTimeout(() => input.style.animation = "", 400);
        }

        // ── Char Counter ───────────────────────────────────────────────────────
        function updateCharCount(count) {
        const counter = document.getElementById("charCounter");
        if (count === 0) { counter.style.display = "none"; return; }
        counter.style.display = "block";
        counter.textContent = `${count}/${VALIDATION.maxLength}`;
        counter.style.color = count > 450 ? "#ef4444" : count > 350 ? "#f59e0b" : "#9ca3af";
        }

        // ── Edit Message ───────────────────────────────────────────────────────
        function editMessage(btn, originalText) {
        editingMsgEl = btn.closest('.user-msg-wrap');
        document.getElementById("editInput").value = originalText;
        document.getElementById("editError").style.display = "none";
        document.getElementById("editModal").style.display = "flex";
        }

        function cancelEdit() {
        document.getElementById("editModal").style.display = "none";
        editingMsgEl = null;
        }

        async function confirmEdit() {
        const newText = document.getElementById("editInput").value.trim();
        const errEl = document.getElementById("editError");

        if (!newText) {
        errEl.textContent = "⚠️ Message cannot be empty!";
        errEl.style.display = "block";
        return;
        }
        if (newText.length > VALIDATION.maxLength) {
        errEl.textContent = `⚠️ Too long! Max ${VALIDATION.maxLength} chars.`;
        errEl.style.display = "block";
        return;
        }

        if (editingMsgEl) editingMsgEl.remove();
        document.getElementById("editModal").style.display = "none";
        editingMsgEl = null;
        await sendMessage(newText);
        }

        // ── Clear Chat ─────────────────────────────────────────────────────────
        function clearChat() {
        const existing = document.querySelector('.clear-confirm');
        if (existing) { existing.remove(); return; }
        const box = document.getElementById("chatBox");
        const confirmDiv = document.createElement("div");
        confirmDiv.className = "clear-confirm";
        confirmDiv.innerHTML = `
        <span>🗑️ Clear all messages?</span>
        <div class="clear-confirm-btns">
        <button class="btn-yes" onclick="confirmClear()">Yes</button>
        <button class="btn-no" onclick="this.closest('.clear-confirm').remove()">No</button>
        </div>`;
        box.insertBefore(confirmDiv, box.querySelector('.chat-input-area'));
        }

        function confirmClear() {
        document.getElementById("chatBody").innerHTML = `
        <div class="bot-msg-wrap">
        <span class="msg-avatar">🤖</span>
        <div class="bot-msg">Chat cleared! 🧹 How can I help you?</div>
        </div>`;
        document.querySelector('.clear-confirm')?.remove();
        frontendMsgTimes = [];
        clearInputError();
        }

        // ── Feedback ───────────────────────────────────────────────────────────
        function giveFeedback(btn, type) {
        btn.closest('.feedback-wrap').querySelectorAll('.feedback-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        btn.textContent = type === '👍' ? '👍 Thanks!' : '👎 Noted!';
        setTimeout(() => btn.closest('.feedback-wrap').style.opacity = '0.6', 1000);
        }

        // ── Copy ───────────────────────────────────────────────────────────────
        function copyMessage(text) {
        navigator.clipboard.writeText(text).then(() => showToast('📋 Copied!'));
        }

        // ── Toast ──────────────────────────────────────────────────────────────
        function showToast(msg) {
        const t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:100px;left:50%;transform:translateX(-50%);background:#1e1e2e;color:white;padding:8px 18px;border-radius:20px;font-size:13px;z-index:99999;opacity:0;transition:opacity 0.2s;';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => t.style.opacity = '1', 10);
        setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 200); }, 1500);
        }

        // ── Helpers ────────────────────────────────────────────────────────────
        function scrollToBottom() { setTimeout(() => document.getElementById("chatBody").scrollTop = document.getElementById("chatBody").scrollHeight, 50); }
        function escapeHtml(t) { return t.replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>').replace(/"/g,'"'); }
        function escapeForAttr(t) { return t.replace(/'/g,"\\'").replace(/"/g,'"').replace(/\n/g,'\\n'); }

        // ── DOMContentLoaded ───────────────────────────────────────────────────
        document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("chatInput");
        if (input) {
        // Enter to send
        input.addEventListener("keypress", e => { if (e.key === "Enter") sendMessage(); });

        // Char counter
        input.addEventListener("input", function () {
        updateCharCount(this.value.length);
        if (this.value.length > 0) clearInputError();
        });

        // Paste - trim if too long
        input.addEventListener("paste", function () {
        setTimeout(() => {
        if (this.value.length > VALIDATION.maxLength) {
        this.value = this.value.substring(0, VALIDATION.maxLength);
        showInputError(`⚠️ Pasted text trimmed to ${VALIDATION.maxLength} characters!`);
        }
        updateCharCount(this.value.length);
        }, 0);
        });
        }

        // Edit modal - click outside to close
        document.getElementById("editModal").addEventListener("click", function (e) {
        if (e.target === this) cancelEdit();
        });
        });
        document.addEventListener('DOMContentLoaded', function () {
        var path = window.location.pathname.toLowerCase();
        if (path.includes('/onboarding/dashboard')) {
        if (path.includes('/performance/dashboard')) {
        var s = document.getElementById('dashboardsSubmenu');
        var c = document.getElementById('dashboardsChevron');
        if (s) s.style.display = 'block';
        if (c) c.classList.add('open');
        document.querySelectorAll('.nav-sublink').forEach(function(link) {
        if ((link.getAttribute('href') || '').toLowerCase() === path) {
        link.classList.add('active');
        }
        });
        }
        var s = document.getElementById('dashboardsSubmenu');
        var c = document.getElementById('dashboardsChevron');
        if (s) s.style.display = 'block';
        if (c) c.classList.add('open');
        document.querySelectorAll('.nav-sublink').forEach(function(link) {
        if ((link.getAttribute('href') || '').toLowerCase() === path) {
        link.classList.add('active');
        }
        });
        }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
