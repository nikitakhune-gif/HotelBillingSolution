@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>

    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins',sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: linear-gradient(135deg,#0f172a,#1e293b,#334155);
            }

            .card {
                width: 400px;
                background: #fff;
                padding: 40px 35px;
                border-radius: 20px;
                box-shadow: 0 20px 40px rgba(0,0,0,.25);
            }

                .card .icon-circle {
                    width: 65px;
                    height: 65px;
                    background: #eff6ff;
                    border-radius: 50%;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    margin: 0 auto 18px;
                }

                    .card .icon-circle i {
                        font-size: 30px;
                        color: #2563eb;
                    }

                .card h2 {
                    text-align: center;
                    margin-bottom: 8px;
                    color: #0f172a;
                }

                .card p.desc {
                    text-align: center;
                    font-size: 14px;
                    color: #666;
                    margin-bottom: 25px;
                    line-height: 1.5;
                }

            .input-group {
                position: relative;
                margin: 18px 0;
            }

                .input-group i {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    font-size: 22px;
                    color: #777;
                }

                .input-group input {
                    width: 100%;
                    padding: 14px 15px 14px 50px;
                    border: 2px solid #eee;
                    border-radius: 10px;
                    outline: none;
                    font-size: 15px;
                }

                    .input-group input:focus {
                        border-color: #2563eb;
                    }

            button {
                width: 100%;
                padding: 13px;
                border: none;
                border-radius: 10px;
                background: #2563eb;
                color: #fff;
                font-size: 16px;
                font-weight: 500;
                cursor: pointer;
                transition: .3s;
            }

                button:hover {
                    background: #1d4ed8;
                }

                button:disabled {
                    background: #93c5fd;
                    cursor: not-allowed;
                }

            .msg {
                text-align: center;
                font-size: 13px;
                margin-top: 14px;
                min-height: 18px;
            }

                .msg.success {
                    color: #16a34a;
                }

                .msg.error {
                    color: #dc2626;
                }

            .back-link {
                display: block;
                text-align: center;
                margin-top: 22px;
                font-size: 14px;
                color: #2563eb;
                font-weight: 500;
                text-decoration: none;
            }

                .back-link:hover {
                    text-decoration: underline;
                }

            .hint {
                margin-top: 18px;
                background: #f8fafc;
                border: 1px solid #eef2f7;
                border-radius: 10px;
                padding: 10px 12px;
                font-size: 12px;
                color: #64748b;
                text-align: center;
            }

            @@media(max - width:480px) {
                .card {
                    width: 92%;
                    padding: 30px 22px;
                }
            }
    </style>
</head>

<body>

    <div class="card">

        <div class="icon-circle">
            <i class='bx bxs-lock-open-alt'></i>
        </div>

        <h2>Forgot Password?</h2>
        

        <form id="forgotForm" method="post" asp-controller="Account" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()

            <div class="input-group">
                <i class='bx bx-envelope'></i>
                <input name="email" id="email" type="email" placeholder="Enter your registered email" required />
            </div>

            <button type="submit" id="sendBtn">Send OTP</button>
        </form>

        <div id="formMsg" class="msg"></div>

        

        <a class="back-link" asp-controller="Account" asp-action="Login">&larr; Back to Login</a>

    </div>

    <script>

            const form = document.getElementById("forgotForm");
            const sendBtn = document.getElementById("sendBtn");
            const formMsg = document.getElementById("formMsg");

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                formMsg.textContent = "";
                formMsg.className = "msg";

                const email = document.getElementById("email").value.trim();
                const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                sendBtn.disabled = true;
                sendBtn.textContent = "Sending OTP...";

                try {
                    const res = await fetch(form.action, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": token
                        },
                        body: "email=" + encodeURIComponent(email) + "&__RequestVerificationToken=" + encodeURIComponent(token)
                    });

                    const data = await res.json().catch(() => ({ success: res.ok }));

                    if (res.ok && data.success !== false) {
                        formMsg.textContent = "OTP sent successfully! Redirecting to reset page...";
                        formMsg.classList.add("success");

                        setTimeout(() => {
                            window.location.href = "/Account/ResetPassword?email=" + encodeURIComponent(email);
                        }, 1200);
                    } else {
                        formMsg.textContent = data.message || "No account found with this email. Please check and try again.";
                        formMsg.classList.add("error");
                        sendBtn.disabled = false;
                        sendBtn.textContent = "Send OTP";
                    }
                } catch (err) {
                    formMsg.textContent = "Something went wrong. Please try again in a moment.";
                    formMsg.classList.add("error");
                    sendBtn.disabled = false;
                    sendBtn.textContent = "Send OTP";
                }
            });

    </script>

</body>
</html>
