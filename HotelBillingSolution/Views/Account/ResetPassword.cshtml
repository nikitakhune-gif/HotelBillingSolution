@{
    Layout = null;
    var email = Context.Request.Query["email"].ToString();
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>

    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins',sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: linear-gradient(135deg,#0f172a,#1e293b,#334155);
            }

            .card {
                width: 400px;
                background: #fff;
                padding: 40px 35px;
                border-radius: 20px;
                box-shadow: 0 20px 40px rgba(0,0,0,.25);
            }

                .card .icon-circle {
                    width: 65px;
                    height: 65px;
                    background: #eff6ff;
                    border-radius: 50%;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    margin: 0 auto 18px;
                }

                    .card .icon-circle i {
                        font-size: 30px;
                        color: #2563eb;
                    }

                .card h2 {
                    text-align: center;
                    margin-bottom: 8px;
                    color: #0f172a;
                }

                .card p.desc {
                    text-align: center;
                    font-size: 14px;
                    color: #666;
                    margin-bottom: 10px;
                    line-height: 1.5;
                }

                    .card p.desc strong {
                        color: #2563eb;
                    }

            .input-group {
                position: relative;
                margin: 18px 0;
            }

                .input-group i {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    font-size: 22px;
                    color: #777;
                }

                .input-group input {
                    width: 100%;
                    padding: 14px 15px 14px 50px;
                    border: 2px solid #eee;
                    border-radius: 10px;
                    outline: none;
                    font-size: 15px;
                }

                    .input-group input:focus {
                        border-color: #2563eb;
                    }

                .input-group .toggle-eye {
                    position: absolute;
                    right: 15px;
                    left: auto;
                    cursor: pointer;
                }

            button {
                width: 100%;
                padding: 13px;
                border: none;
                border-radius: 10px;
                background: #2563eb;
                color: #fff;
                font-size: 16px;
                font-weight: 500;
                cursor: pointer;
                transition: .3s;
            }

                button:hover {
                    background: #1d4ed8;
                }

                button:disabled {
                    background: #93c5fd;
                    cursor: not-allowed;
                }

            .resend {
                text-align: center;
                font-size: 13px;
                margin-top: 14px;
                color: #666;
            }

                .resend .pointer {
                    color: #2563eb;
                    font-weight: 600;
                    cursor: pointer;
                }

                    .resend .pointer.disabled {
                        color: #aaa;
                        cursor: not-allowed;
                    }

            .msg {
                text-align: center;
                font-size: 13px;
                margin-top: 14px;
                min-height: 18px;
            }

                .msg.success {
                    color: #16a34a;
                }

                .msg.error {
                    color: #dc2626;
                }

            .back-link {
                display: block;
                text-align: center;
                margin-top: 18px;
                font-size: 14px;
                color: #2563eb;
                font-weight: 500;
                text-decoration: none;
            }

                .back-link:hover {
                    text-decoration: underline;
                }

            @@media(max - width:480px) {
                .card {
                    width: 92%;
                    padding: 30px 22px;
                }
            }
    </style>
</head>

<body>

    <div class="card">

        <div class="icon-circle">
            <i class='bx bxs-key'></i>
        </div>

        <h2>Reset Password</h2>
        <p class="desc">Enter the OTP sent to <strong>@email</strong> along with your new password.</p>

        <form id="resetForm" method="post" asp-controller="Account" asp-action="ResetPassword">
            @Html.AntiForgeryToken()

            <input type="hidden" name="email" value="@email" />

            <div class="input-group">
                <i class='bx bxs-key'></i>
                <input name="otp" type="text" placeholder="Enter OTP" maxlength="6" required />
            </div>

            <div class="input-group">
                <i class='bx bxs-lock-alt'></i>
                <input name="newPassword" id="newPassword" type="password" placeholder="New Password" required />
                <i class='bx bx-show toggle-eye' onclick="toggleEye('newPassword', this)"></i>
            </div>

            <div class="input-group">
                <i class='bx bxs-lock-alt'></i>
                <input name="confirmNewPassword" id="confirmNewPassword" type="password" placeholder="Confirm New Password" required />
                <i class='bx bx-show toggle-eye' onclick="toggleEye('confirmNewPassword', this)"></i>
            </div>

            <button type="submit" id="resetBtn">Reset Password</button>
        </form>

        <div id="formMsg" class="msg"></div>

        <div class="resend">
            Didn't receive the OTP?
            <span class="pointer" id="resendBtn" onclick="resendOtp()">Resend OTP</span>
        </div>

        <a class="back-link" asp-controller="Account" asp-action="Login">&larr; Back to Login</a>

    </div>

    <script>

            function toggleEye(inputId, icon){
                const input = document.getElementById(inputId);
                if(input.type === "password"){
                    input.type = "text";
                    icon.classList.remove("bx-show");
                    icon.classList.add("bx-hide");
                } else {
                    input.type = "password";
                    icon.classList.remove("bx-hide");
                    icon.classList.add("bx-show");
                }
            }

            const form = document.getElementById("resetForm");
            const resetBtn = document.getElementById("resetBtn");
            const formMsg = document.getElementById("formMsg");

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                formMsg.textContent = "";
                formMsg.className = "msg";

                const newPassword = document.getElementById("newPassword").value;
                const confirmNewPassword = document.getElementById("confirmNewPassword").value;

                if (newPassword !== confirmNewPassword) {
                    formMsg.textContent = "Passwords do not match. Please re-check.";
                    formMsg.classList.add("error");
                    return;
                }

                const formData = new FormData(form);
                const params = new URLSearchParams();
                for (const pair of formData) { params.append(pair[0], pair[1]); }

                const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                resetBtn.disabled = true;
                resetBtn.textContent = "Resetting...";

                try {
                    const res = await fetch(form.action, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": token
                        },
                        body: params.toString()
                    });

                    const data = await res.json().catch(() => ({ success: res.ok }));

                    if (res.ok && data.success !== false) {
                        formMsg.textContent = "Password reset successful! Redirecting to login...";
                        formMsg.classList.add("success");

                        setTimeout(() => {
                            window.location.href = "/Account/Login";
                        }, 1200);
                    } else {
                        formMsg.textContent = data.message || "Invalid or expired OTP. Please try again.";
                        formMsg.classList.add("error");
                        resetBtn.disabled = false;
                        resetBtn.textContent = "Reset Password";
                    }
                } catch (err) {
                    formMsg.textContent = "Something went wrong. Please try again.";
                    formMsg.classList.add("error");
                    resetBtn.disabled = false;
                    resetBtn.textContent = "Reset Password";
                }
            });

            let resendCooldown = false;

            async function resendOtp(){
                if(resendCooldown) return;

                const resendBtn = document.getElementById("resendBtn");
                const email = "@email";
                const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                resendCooldown = true;
                resendBtn.classList.add("disabled");
                let seconds = 30;
                resendBtn.textContent = "Resend in " + seconds + "s";

                const interval = setInterval(() => {
                    seconds--;
                    resendBtn.textContent = "Resend in " + seconds + "s";
                    if(seconds <= 0){
                        clearInterval(interval);
                        resendBtn.textContent = "Resend OTP";
                        resendBtn.classList.remove("disabled");
                        resendCooldown = false;
                    }
                }, 1000);

                try {
                    await fetch("/Account/ForgotPassword", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": token
                        },
                        body: "email=" + encodeURIComponent(email) + "&__RequestVerificationToken=" + encodeURIComponent(token)
                    });

                    formMsg.textContent = "A new OTP has been sent to your email.";
                    formMsg.className = "msg success";
                } catch(err){
                    formMsg.textContent = "Could not resend OTP. Please try again.";
                    formMsg.className = "msg error";
                }
            }

    </script>

</body>
</html>
