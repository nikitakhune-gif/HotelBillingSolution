@model HotelBilling.Application.DTOs.Booking.BookingCreateDto
@{
    ViewData["Title"] = "New Booking";
    ViewBag.ActiveMenu = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Rooms available to pick from. Populate this in the controller, e.g.:
    //   ViewBag.AvailableRooms = await _roomService.GetAvailableRoomsAsync();
    // Type: IEnumerable<HotelBilling.Application.DTOs.Room.RoomDto>
    var availableRooms = ViewBag.AvailableRooms as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

@functions {
    // -----------------------------------------------------------------
    // GetProp: reads a value off a room object no matter what shape it
    // arrives in (Dictionary<string,object>, ExpandoObject, or a typed
    // RoomDto). It tries every candidate property/key name, case
    // insensitively, and returns the first non-null match.
    // -----------------------------------------------------------------
    static string GetProp(object obj, params string[] names)
    {
        if (obj == null) return null;

        if (obj is System.Collections.IDictionary dict)
        {
            foreach (var n in names)
            {
                foreach (System.Collections.DictionaryEntry entry in dict)
                {
                    if (entry.Key != null && string.Equals(entry.Key.ToString(), n, StringComparison.OrdinalIgnoreCase))
                    {
                        var v = entry.Value;
                        if (v != null && !string.IsNullOrWhiteSpace(v.ToString())) return v.ToString();
                    }
                }
            }
            return null;
        }

        var type = obj.GetType();
        foreach (var n in names)
        {
            var prop = type.GetProperty(n,
                System.Reflection.BindingFlags.IgnoreCase |
                System.Reflection.BindingFlags.Public |
                System.Reflection.BindingFlags.Instance);
            if (prop != null)
            {
                var val = prop.GetValue(obj);
                if (val != null && !string.IsNullOrWhiteSpace(val.ToString())) return val.ToString();
            }
        }
        return null;
    }
}

@* =========================================================================
   AddBooking.cshtml

   FIX ROUND (this revision) — root cause of the two bugs you reported:

   1) "Whole page blinks / shakes when I click Check Availability and
      after filling everything and clicking Finish, it doesn't go to
      the Booking Index page and the new booking is not visible."

      -> Check Availability itself is a plain fetch() to
         /Booking/GetAvailableRooms and can't cause a full page reload
         by itself (the button is type="button"). The real "blink" is
         almost certainly the FINISH click: form.submit() does a full
         browser POST to AddBooking. If ASP.NET ModelState is invalid
         on the server (a field the client-side didn't validate, a
         DTO mismatch, etc.) the controller re-renders THIS SAME VIEW
         instead of redirecting — which the browser shows as a
         full-page flash/reload, and because nothing on this page
         displayed the validation errors, it looked like nothing
         happened and no booking was ever saved.

         FIX: added an asp-validation-summary block right under the
         antiforgery token so any server-side ModelState errors are
         now actually visible instead of silently reloading the page.
         If Finish still doesn't redirect after this, whatever text
         shows up there (or the Network tab response for the POST)
         will tell us exactly which field/DTO mismatch is blocking the
         save — share that and I'll patch it precisely.

   2) All blocking alert() popups (guest details, dates, payment
      method, room selection) have been replaced with a single
      non-blocking inline banner (#formBanner). Repeated alert()
      dialogs are what made the page feel like it was vibrating/
      shaking on repeated clicks — this removes that entirely.

   3) Check Availability button now shows an inline loading state
      instead of instantly swapping the table body, so the sudden
      change in table height doesn't yank the page/scroll position
      around, and network failures show a banner instead of alert().

   Everything else (theme fix, table-bk fix, GetProp-based room
   binding) is unchanged from the previous revision.
   ========================================================================= *@

<style>
    /* Map local shorthand tokens to global theme tokens so this file
               always respects [data-theme] values from site.css. Avoid --bs-* */
    :root {
        --primary: var(--primary-color);
        --primary-light: var(--primary-color-2);
        --border: var(--border-color);
        --card: var(--card-color);
        --card-2: var(--card-color-2);
        --input: var(--input-color);
        --text: var(--text-color);
        --text-muted-local: var(--text-muted);
        --text-faint-local: var(--text-faint);
        --primary-soft-local: var(--primary-soft);
        --success-local: var(--success-color);
        --success-soft-local: var(--success-soft);
        --warning-local: var(--warning-color);
        --danger-local: var(--danger-color);
        --shadow-sm-local: var(--shadow-sm);
        --shadow-md-local: var(--shadow-md);
        --shadow-lg-local: var(--shadow-lg);
        /* text to use on strong primary backgrounds */
        --on-primary: var(--heading-color);
    }

    .booking-page {
        --bk-accent-1: var(--primary-color);
        --bk-accent-2: var(--primary-color-2);
        --bk-accent-gradient: linear-gradient(135deg, var(--bk-accent-1) 0%, var(--bk-accent-2) 100%);
        --bk-success: var(--success-color);
        --bk-success-soft: var(--success-soft);
        --bk-warning: var(--warning-color);
        --bk-danger: var(--danger-color);
        --bk-radius-lg: 18px;
        --bk-radius-md: 14px;
        --bk-radius-sm: 10px;
        --bk-card-bg: var(--card-color);
        --bk-border: var(--border-color);
        --bk-muted: var(--text-muted);
        --bk-shadow-sm: var(--shadow-sm);
        --bk-shadow-md: var(--shadow-md);
        --bk-shadow-lg: var(--shadow-lg);
        color: var(--text);
        background: var(--bg-color);
        padding-bottom: 3rem;
    }

        .booking-page * {
            box-sizing: border-box;
        }

    /* ---------- Glass card base ---------- */
    .bk-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--bk-radius-lg);
        box-shadow: var(--shadow-sm-local);
        transition: box-shadow .25s ease, transform .25s ease, border-color .25s ease;
    }

        .bk-card:hover {
            box-shadow: var(--bk-shadow-md);
        }

    .bk-card-body {
        padding: 1.75rem;
    }

    @@media (max-width: 575.98px) {
        .bk-card-body {
            padding: 1.25rem;
        }
    }

    /* ---------- Page header ---------- */
    .bk-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
    }

    .bk-header-title {
        font-weight: 700;
        font-size: 1.65rem;
        letter-spacing: -0.02em;
        margin-bottom: .35rem;
        color: var(--heading-color);
    }

        .bk-header-title .bk-title-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--bk-accent-gradient);
            margin-inline-end: .55rem;
            box-shadow: 0 0 0 4px var(--primary-soft);
        }

    .bk-header-sub {
        color: var(--bk-muted);
        font-size: .93rem;
        margin: 0;
    }

    .bk-header-actions {
        display: flex;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .btn-bk-ghost {
        border-radius: 12px;
        border: 1px solid var(--bk-border);
        background: transparent;
        color: var(--text);
        font-weight: 500;
        padding: .55rem 1.1rem;
        transition: all .2s ease;
    }

        .btn-bk-ghost:hover {
            border-color: var(--bk-accent-1);
            color: var(--bk-accent-1);
            background: var(--primary-soft);
        }

    .btn-bk-primary {
        border-radius: 12px;
        border: none;
        background: var(--bk-accent-gradient);
        color: var(--on-primary);
        font-weight: 600;
        padding: .55rem 1.3rem;
        box-shadow: var(--hover-glow);
        transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
    }

        .btn-bk-primary:hover {
            transform: translateY(-1px);
            color: #fff;
        }

        .btn-bk-primary:active {
            transform: translateY(0);
        }

        .btn-bk-primary:disabled {
            opacity: .65;
            cursor: not-allowed;
            transform: none;
        }

    /* ---------- Stepper ---------- */
    .bk-stepper {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        list-style: none;
        margin: 0 0 1.75rem;
        padding: 1.1rem 1.5rem;
        border-radius: var(--bk-radius-lg);
        background: var(--card);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm-local);
    }

    .bk-step {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-width: 0;
    }

        .bk-step:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 21px;
            left: calc(50% + 30px);
            right: calc(-50% + 30px);
            height: 3px;
            background: var(--bk-border);
            border-radius: 2px;
            z-index: 0;
            transition: background .3s ease;
        }

        .bk-step.completed:not(:last-child)::after {
            background: var(--bk-success);
        }

    .bk-step-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.05rem;
        background: var(--input);
        border: 2px solid var(--border);
        color: var(--text-muted-local);
        position: relative;
        z-index: 1;
        transition: all .3s ease;
    }

    .bk-step.active .bk-step-circle {
        background: var(--bk-accent-gradient);
        border-color: transparent;
        color: var(--on-primary);
        box-shadow: var(--hover-glow);
    }

    .bk-step.completed .bk-step-circle {
        background: var(--success-local);
        border-color: transparent;
        color: var(--on-primary);
    }

    .bk-step-label {
        margin-top: .55rem;
        font-size: .82rem;
        font-weight: 600;
        color: var(--bk-muted);
    }

    .bk-step-sub {
        font-size: .72rem;
        color: var(--bk-muted);
        opacity: .8;
    }

    .bk-step.active .bk-step-label {
        color: var(--bk-accent-1);
    }

    .bk-step.completed .bk-step-label {
        color: var(--bk-success);
    }

    @@media (max-width: 767.98px) {
        .bk-step-label {
            font-size: .72rem;
        }

        .bk-stepper {
            padding: 1rem .75rem;
        }

        .bk-step:not(:last-child)::after {
            top: 18px;
        }

        .bk-step-circle {
            width: 36px;
            height: 36px;
            font-size: .9rem;
        }
    }

    /* ---------- Section headings ---------- */
    .bk-section-title {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-weight: 700;
        font-size: 1.05rem;
        margin-bottom: 1.35rem;
        color: var(--heading-color);
    }

        .bk-section-title .bk-section-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-soft-local);
            color: var(--primary);
            font-size: 1rem;
        }

    /* ---------- Floating inputs ---------- */
    .bk-field {
        position: relative;
        margin-bottom: 1.15rem;
    }

        .bk-field > label {
            position: absolute;
            top: 50%;
            left: 2.55rem;
            transform: translateY(-50%);
            font-size: .92rem;
            color: var(--bk-muted);
            background: transparent;
            pointer-events: none;
            transition: all .18s ease;
        }

        .bk-field .form-control,
        .bk-field .form-select {
            border-radius: var(--bk-radius-sm);
            border: 1.5px solid var(--border);
            background: var(--input);
            padding: 1.05rem .9rem .35rem 2.55rem;
            height: 54px;
            font-size: .93rem;
            color: var(--text);
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .bk-field .form-control::placeholder {
                color: transparent;
            }

            .bk-field .form-control:focus,
            .bk-field .form-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px var(--primary-soft-local);
            }

                .bk-field .form-control:focus ~ label,
                .bk-field .form-control:not(:placeholder-shown) ~ label,
                .bk-field .form-select:focus ~ label,
                .bk-field select.form-select ~ label {
                    top: 1rem;
                    font-size: .68rem;
                    font-weight: 600;
                    color: var(--primary);
                }

        .bk-field.no-icon > label {
            left: 1rem;
        }

        .bk-field.no-icon .form-control,
        .bk-field.no-icon .form-select {
            padding-left: 1rem;
        }

    .bk-field-icon {
        position: absolute;
        left: .9rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--bk-muted);
        font-size: .95rem;
        z-index: 3;
        pointer-events: none;
    }

    .bk-field textarea.form-control {
        height: auto;
        min-height: 86px;
        padding-top: 1.35rem;
        resize: vertical;
    }

    .bk-required {
        color: var(--bk-danger);
        margin-left: 2px;
    }

    .bk-phone-group {
        display: flex;
        gap: .5rem;
    }

        .bk-phone-group .bk-field.code-field {
            flex: 0 0 108px;
        }

        .bk-phone-group .bk-field.number-field {
            flex: 1;
        }

    /* ---------- Guest counter ---------- */
    .bk-counter {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1.5px solid var(--border);
        border-radius: var(--bk-radius-sm);
        padding: .55rem .9rem;
        height: 54px;
        background: var(--input);
        margin-bottom: 1.15rem;
    }

    /* Ensure native select respects theme tokens */
    select.form-select,
    select.filter-select,
    select.filter-select--sm,
    select.entries-select {
        background-color: var(--input) !important;
        color: var(--text) !important;
        border-color: var(--border) !important;
    }

    .bk-counter-label {
        font-size: .85rem;
        font-weight: 600;
        color: var(--text-color);
    }

        .bk-counter-label small {
            display: block;
            font-weight: 400;
            font-size: .72rem;
            color: var(--bk-muted);
        }

    .bk-counter-controls {
        display: flex;
        align-items: center;
        gap: .7rem;
    }

    .bk-counter-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1.5px solid var(--bk-border);
        background: var(--bk-card-bg);
        color: var(--bk-accent-1);
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: all .15s ease;
    }

        .bk-counter-btn:hover {
            background: var(--bk-accent-gradient);
            color: #fff;
            border-color: transparent;
        }

    .bk-counter-value {
        min-width: 22px;
        text-align: center;
        font-weight: 700;
        color: var(--text-color);
    }

    /* ---------- Room search bar ---------- */
    .bk-room-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1.25rem;
        align-items: flex-end;
    }

        .bk-room-toolbar .bk-field {
            margin-bottom: 0;
            flex: 1 1 200px;
        }

        .bk-room-toolbar .bk-btn-check-avail {
            flex: 0 0 auto;
        }

    .btn-bk-check {
        border-radius: var(--bk-radius-sm);
        background: var(--bk-accent-gradient);
        color: #fff;
        border: none;
        font-weight: 600;
        padding: 0 1.4rem;
        height: 54px;
        white-space: nowrap;
        box-shadow: var(--hover-glow);
        transition: opacity .15s ease;
    }

        .btn-bk-check.is-loading {
            opacity: .7;
            pointer-events: none;
        }

    /* ---------- Room table ---------- */
    .bk-table-wrap {
        border-radius: var(--bk-radius-md);
        border: 1px solid var(--bk-border);
        overflow: hidden;
        /* Reserve a minimum height so swapping table rows via AJAX
               doesn't collapse/expand the page abruptly (this was part of
               the "page shakes" feeling on Check Availability). */
        min-height: 160px;
    }

        .bk-table-wrap .table-responsive {
            background: transparent;
        }

    .table-bk {
        margin: 0;
        font-size: .87rem;
        vertical-align: middle;
        min-width: 760px;
        /* FIX: Bootstrap's base .table styles color/background using
                   --bs-table-bg / --bs-table-color, which are NOT linked to
                   this app's [data-theme] switch. Left unset, the table
                   rendered as an opaque white block in dark mode. Force those
                   variables to the themed card background/text instead. */
        --bs-table-bg: transparent;
        --bs-table-color: var(--text-color);
        --bs-table-striped-bg: transparent;
        --bs-table-hover-bg: var(--hover-bg);
        background-color: transparent;
        color: var(--text-color);
    }

        .table-bk thead th {
            background: var(--card-color-2);
            border-bottom: 1px solid var(--bk-border);
            font-weight: 700;
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--bk-muted);
            padding: .85rem .9rem;
            white-space: nowrap;
        }

        .table-bk tbody td {
            padding: .75rem .9rem;
            border-bottom: 1px solid var(--bk-border);
            background-color: transparent;
            color: var(--text-color);
        }

        .table-bk tbody tr {
            background-color: transparent;
            transition: background .15s ease;
        }

            .table-bk tbody tr:hover {
                background: var(--hover-bg);
            }

                .table-bk tbody tr:hover td {
                    background-color: transparent;
                }

            .table-bk tbody tr:last-child td {
                border-bottom: none;
            }

            .table-bk tbody tr.row-selected,
            .table-bk tbody tr.row-selected td {
                background: var(--primary-soft);
            }

    .bk-room-thumb {
        width: 56px;
        height: 44px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid var(--bk-border);
    }

    .bk-status {
        font-size: .7rem;
        font-weight: 700;
