        white-space: nowrap;
    }

    .bk-status-available {
        background: var(--bk-success-soft);
        color: var(--bk-success);
    }

    .bk-status-occupied {
        background: var(--danger-soft);
        color: var(--bk-danger);
    }

    .bk-status-reserved {
        background: var(--warning-soft);
        color: var(--bk-warning);
    }

    .bk-status-maintenance {
