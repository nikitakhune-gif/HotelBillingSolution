@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Customer Report</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/css/site.css" />
    <style>
        body{font-family:Inter,Segoe UI,Arial;background:#f6f7fb;color:#131b2e;padding:24px}
        .card{background:#fff;border:1px solid #eaecf1;border-radius:12px;padding:18px;max-width:1100px;margin:0 auto}
        .title{font-size:20px;font-weight:700;margin-bottom:8px}
        .controls{margin-top:12px;display:flex;gap:8px}
        .btn{background:#2f6feb;color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none}
        table{width:100%;border-collapse:collapse;margin-top:12px}
        th,td{padding:10px;border-bottom:1px solid #eaecf1;text-align:left}
    </style>
</head>
<body>
    <div class="card">
        <div class="title">Customer Report</div>
        <div>Date Range: <input type="date" id="from" /> - <input type="date" id="to" /></div>
        <div class="controls">
            <a id="filterBtn" class="btn">Filter</a>
            <a id="downloadBtn" class="btn">Download Report</a>
            <a href="/Reports" class="btn" style="background:#fff;color:#2f6feb;border:1px solid #2f6feb">Back to Reports</a>
        </div>

        <div style="margin-top:12px;display:flex;gap:12px">
            <div style="background:#eef5ff;padding:12px;border-radius:10px;flex:1"><div style="font-size:13px;color:#8993a4">Total Customers</div><div style="font-weight:700">320</div></div>
            <div style="background:#f1ecfe;padding:12px;border-radius:10px;flex:1"><div style="font-size:13px;color:#8993a4">New Customers</div><div style="font-weight:700">48</div></div>
            <div style="background:#e7f8ee;padding:12px;border-radius:10px;flex:1"><div style="font-size:13px;color:#8993a4">Returning</div><div style="font-weight:700">82</div></div>
        </div>

        <table>
            <thead>
                <tr><th>Customer Name</th><th>Email</th><th>Phone</th><th>Bookings</th><th>Total Spent</th><th>Last Visit</th></tr>
            </thead>
            <tbody id="tbody"></tbody>
        </table>
    </div>

    <script>
        async function load(){
            try{
                const res = await fetch('/api/reports/customers');
                if(!res.ok) throw new Error('noapi');
                const data = await res.json();
                if(!data || data.length===0){ document.getElementById('tbody').innerHTML = '<tr><td colspan="6">No data available for the selected date range.</td></tr>'; return; }
                document.getElementById('tbody').innerHTML = data.map(c=>`<tr><td class="name">${c.name}</td><td>${c.email}</td><td>${c.phone}</td><td>${c.bookings}</td><td>${c.totalSpent}</td><td>${c.lastVisit||'-'}</td></tr>`).join('');
            }catch(e){ document.getElementById('tbody').innerHTML = '<tr><td colspan="6">No data available for the selected date range.</td></tr>'; }
        }
        load();
    </script>
</body>
</html>
