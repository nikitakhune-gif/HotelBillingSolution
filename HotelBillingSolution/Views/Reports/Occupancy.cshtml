@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Occupancy Report</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body{font-family:Inter,Segoe UI,Arial;background:#f6f7fb;color:#131b2e;padding:24px}
        .card{background:#fff;border:1px solid #eaecf1;border-radius:12px;padding:18px;max-width:1100px;margin:0 auto}
        .title{font-size:20px;font-weight:700;margin-bottom:8px}
        .btn{background:#2f6feb;color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none}
    </style>
</head>
<body>
    <div class="card">
        <div class="title">Occupancy Report</div>
        <div>Date Range: <input type="date" id="from" /> - <input type="date" id="to" /></div>
        <div style="margin-top:12px"><a href="/Reports" class="btn" style="background:#fff;color:#2f6feb;border:1px solid #2f6feb">Back to Reports</a></div>

        <div id="summary" style="margin-top:12px"></div>
        <div id="chart" style="margin-top:12px;height:220px;background:#fff;border-radius:8px;border:1px solid #eaecf1;display:flex;align-items:center;justify-content:center;color:#8993a4">Occupancy chart placeholder</div>
    </div>
    <script>
        async function load(){
            try{
                const res = await fetch('/api/reports/occupancy');
                if(!res.ok) throw new Error('noapi');
                const data = await res.json();
                if(!data){ document.getElementById('summary').innerText='No data available for the selected date range.'; return; }
                document.getElementById('summary').innerHTML = `<div style="display:flex;gap:12px"><div style="background:#eef5ff;padding:12px;border-radius:10px;flex:1"><div style="font-size:13px;color:#8993a4">Occupancy</div><div style="font-weight:700">${data.occupancy}%</div></div><div style="background:#fff3e8;padding:12px;border-radius:10px;flex:1"><div style="font-size:13px;color:#8993a4">Available</div><div style="font-weight:700">${data.available}</div></div></div>`;
            }catch(e){ document.getElementById('summary').innerText='No data available for the selected date range.'; }
        }
        load();
    </script>
</body>
</html>
