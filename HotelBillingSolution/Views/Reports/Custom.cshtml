@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Custom Report</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body{font-family:Inter,Segoe UI,Arial;background:#f6f7fb;color:#131b2e;padding:24px}
        .card{background:#fff;border:1px solid #eaecf1;border-radius:12px;padding:18px;max-width:1100px;margin:0 auto}
        .title{font-size:20px;font-weight:700;margin-bottom:8px}
        .btn{background:#2f6feb;color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none}
        table{width:100%;border-collapse:collapse;margin-top:12px}
        th,td{padding:10px;border-bottom:1px solid #eaecf1;text-align:left}
    </style>
</head>
<body>
    <div class="card">
        <div class="title">Custom Report</div>
        <div>Build a custom report by selecting data sources and filters.</div>
        <div style="margin-top:12px"><a href="/Reports" class="btn" style="background:#fff;color:#2f6feb;border:1px solid #2f6feb">Back to Reports</a></div>

        <div style="margin-top:12px">This feature allows you to compose custom reports. Select the entities and filters, then click Generate.</div>
    </div>
</body>
</html>
