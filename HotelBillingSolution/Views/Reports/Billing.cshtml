@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Billing Report</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body{font-family:Inter,Segoe UI,Arial;background:#f6f7fb;color:#131b2e;padding:24px}
        .card{background:#fff;border:1px solid #eaecf1;border-radius:12px;padding:18px;max-width:1100px;margin:0 auto}
        .title{font-size:20px;font-weight:700;margin-bottom:8px}
        .btn{background:#2f6feb;color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none}
        table{width:100%;border-collapse:collapse;margin-top:12px}
        th,td{padding:10px;border-bottom:1px solid #eaecf1;text-align:left}
    </style>
</head>
<body>
    <div class="card">
        <div class="title">Billing Report</div>
        <div>Date Range: <input type="date" id="from" /> - <input type="date" id="to" /></div>
        <div style="margin-top:12px"><a href="/Reports" class="btn" style="background:#fff;color:#2f6feb;border:1px solid #2f6feb">Back to Reports</a></div>

        <table>
            <thead><tr><th>Bill#</th><th>Customer</th><th>Room</th><th>Total</th><th>Paid</th><th>Due</th></tr></thead>
            <tbody id="tbody"></tbody>
        </table>
    </div>
    <script>
        async function load(){
            try{
                const res = await fetch('/api/reports/bills');
                if(!res.ok) throw new Error('noapi');
                const data = await res.json();
                if(!data || data.length===0){ document.getElementById('tbody').innerHTML = '<tr><td colspan="6">No data available for the selected date range.</td></tr>'; return; }
                document.getElementById('tbody').innerHTML = data.map(b=>`<tr><td>${b.billNumber}</td><td>${b.customer}</td><td>${b.room}</td><td>${b.total}</td><td>${b.paid}</td><td>${b.due}</td></tr>`).join('');
            }catch(e){ document.getElementById('tbody').innerHTML = '<tr><td colspan="6">No data available for the selected date range.</td></tr>'; }
        }
        load();
    </script>
</body>
</html>
