@{
    Layout = null;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Revenue Report</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/css/site.css" />
    <style>
        body{font-family:Inter,Segoe UI,Arial;background:#f6f7fb;color:#131b2e;padding:24px}
        .card{background:#fff;border:1px solid #eaecf1;border-radius:12px;padding:18px;max-width:1100px;margin:0 auto}
        .title{font-size:20px;font-weight:700;margin-bottom:8px}
        .controls{margin-top:12px;display:flex;gap:8px}
        .btn{background:#2f6feb;color:#fff;padding:8px 12px;border-radius:8px;text-decoration:none}
        .kpis{display:flex;gap:12px;margin-top:12px}
        .kpi{background:#eef5ff;padding:12px;border-radius:10px;flex:1}
    </style>
</head>
<body>
    <div class="card">
        <div class="title">Revenue Report</div>
        <div>Date Range: <input type="date" id="from" /> - <input type="date" id="to" /></div>
        <div class="controls">
            <a id="filterBtn" class="btn">Filter</a>
            <a id="downloadBtn" class="btn">Download Report</a>
            <a href="/Reports" class="btn" style="background:#fff;color:#2f6feb;border:1px solid #2f6feb">Back to Reports</a>
        </div>

        <div class="kpis">
            <div class="kpi"><div style="font-size:13px;color:#8993a4">Total Revenue</div><div style="font-weight:700">$284,920</div></div>
            <div class="kpi"><div style="font-size:13px;color:#8993a4">Avg Daily</div><div style="font-weight:700">$17,807</div></div>
            <div class="kpi"><div style="font-size:13px;color:#8993a4">Best Day</div><div style="font-weight:700">16 Aug 2026</div></div>
        </div>

        <div id="chart" style="margin-top:12px"></div>

        <table style="margin-top:12px"><thead><tr><th>Date</th><th>Revenue</th><th>Bookings</th></tr></thead><tbody id="tbody"></tbody></table>
    </div>

    <script>
        async function load(){
            try{
                const res = await fetch('/api/reports/revenue');
                if(!res.ok) throw new Error('noapi');
                const data = await res.json();
                if(!data || data.length===0){ document.getElementById('tbody').innerHTML = '<tr><td colspan="3">No data available for the selected date range.</td></tr>'; return; }
                document.getElementById('tbody').innerHTML = data.map(r=>`<tr><td>${r.date}</td><td>${r.revenue}</td><td>${r.bookings}</td></tr>`).join('');
                document.getElementById('chart').innerHTML = '<div style="height:220px;background:linear-gradient(180deg,#eaf1ff,transparent);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#2f6feb">Revenue chart placeholder</div>';
            }catch(e){ document.getElementById('tbody').innerHTML = '<tr><td colspan="3">No data available for the selected date range.</td></tr>'; document.getElementById('chart').innerHTML = '<div style="height:220px;background:#fff;border-radius:8px;border:1px solid #eaecf1;display:flex;align-items:center;justify-content:center;color:#8993a4">No chart available</div>'; }
        }
        load();
    </script>
</body>
</html>
