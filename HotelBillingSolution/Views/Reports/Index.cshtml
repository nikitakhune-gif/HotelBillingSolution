<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reports Overview - Hotel Management Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
            :root {
                --navy: #131b2e;
                --navy-soft: #3a4257;
                --muted: #8993a4;
                --border: #eaecf1;
                --bg: #f6f7fb;
                --card: #ffffff;
                --blue: #2f6feb;
                --blue-soft: #eaf1ff;
                --green: #1fb15f;
                --green-soft: #e7f8ee;
                --purple: #8b5cf6;
                --purple-soft: #f1ecfe;
                --orange: #f2994a;
                --orange-soft: #fdf0e4;
                --cyan: #17b6c4;
                --cyan-soft: #e6f9fa;
                --shadow: 0 1px 2px rgba(16,24,40,0.04), 0 1px 3px rgba(16,24,40,0.03);
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: 'Inter','Segoe UI',Helvetica,Arial,sans-serif;
                background: var(--bg);
                color: var(--navy);
                -webkit-font-smoothing: antialiased;
            }

            .wrap {
                max-width: 1456px;
                margin: 0 auto;
                padding: 24px 28px 40px;
            }

            /* ---------- HEADER ---------- */
            .top-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 22px;
                flex-wrap: wrap;
                gap: 16px;
            }

                .top-header h1 {
                    font-size: 24px;
                    font-weight: 700;
                    margin: 0 0 4px;
                    letter-spacing: -0.3px;
                }

                .top-header p {
                    margin: 0;
                    font-size: 13.5px;
                    color: var(--muted);
                }

            .header-controls {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .pill {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 9px;
                padding: 9px 14px;
                font-size: 13px;
                color: var(--navy);
                white-space: nowrap;
            }

                .pill svg {
                    flex-shrink: 0;
                }

            .btn {
                display: flex;
                align-items: center;
                gap: 8px;
                border-radius: 9px;
                padding: 9px 16px;
                font-size: 13px;
                font-weight: 600;
                border: 1px solid var(--border);
                background: var(--card);
                color: var(--navy);
                cursor: pointer;
            }

            .btn-primary {
                background: var(--blue);
                border-color: var(--blue);
                color: #fff;
            }

            /* ---------- GRIDS ---------- */
            .grid-5 {
                display: grid;
                grid-template-columns: repeat(5,1fr);
                gap: 16px;
                margin-bottom: 16px;
            }

            /* ---------- KPI CARDS ---------- */
            .kpi-card {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 14px;
                padding: 18px 18px 14px;
                box-shadow: var(--shadow);
            }

            .kpi-top {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 14px;
            }

            .icon-circle {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .kpi-label {
                font-size: 12.5px;
                color: var(--muted);
                font-weight: 500;
            }

            .kpi-value {
                font-size: 22px;
                font-weight: 700;
                margin: 0 0 4px;
                letter-spacing: -0.3px;
            }

            .kpi-delta {
                font-size: 12px;
                color: var(--green);
                font-weight: 600;
                margin-bottom: 10px;
            }

                .kpi-delta span {
                    color: var(--muted);
                    font-weight: 500;
                }

            /* ---------- REPORT CARDS ---------- */
            .report-card {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 14px;
                padding: 18px;
                box-shadow: var(--shadow);
                display: flex;
                flex-direction: column;
            }

            .report-top {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 10px;
            }

            .report-title {
                font-size: 14.5px;
                font-weight: 700;
                margin: 0;
            }

            .report-desc {
                font-size: 12px;
                color: var(--muted);
                line-height: 1.5;
                margin: 0 0 14px;
                min-height: 34px;
            }

            .report-metrics {
                display: flex;
                align-items: baseline;
                gap: 8px;
                margin-bottom: 12px;
            }

            .report-value {
                font-size: 19px;
                font-weight: 700;
            }

            .report-delta {
                font-size: 12px;
                color: var(--green);
                font-weight: 600;
            }

            .view-btn {
                margin-top: auto;
                width: 100%;
                background: var(--blue-soft);
                color: var(--blue);
                border: none;
                border-radius: 8px;
                padding: 9px 0;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
            }

            /* custom report preview */
            .custom-preview {
                background: #f4f6fb;
                border-radius: 10px;
                padding: 10px;
                margin-bottom: 12px;
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                height: 76px;
            }

                .custom-preview .bars {
                    display: flex;
                    align-items: flex-end;
                    gap: 4px;
                    height: 100%;
                }

                    .custom-preview .bars div {
                        width: 6px;
                        border-radius: 2px;
                        background: var(--blue);
                    }

            .custom-dots {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

                .custom-dots span {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    display: block;
                }

            /* ---------- BOTTOM SECTION ---------- */
            .bottom-grid {
                display: grid;
                grid-template-columns: 1.55fr 1fr;
                gap: 16px;
                margin-top: 16px;
            }

            .panel {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 14px;
                padding: 20px;
                box-shadow: var(--shadow);
            }

            .panel-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 14px;
            }

                .panel-head h2 {
                    font-size: 15.5px;
                    margin: 0;
                    font-weight: 700;
                }

            .link {
                font-size: 13px;
                color: var(--blue);
                font-weight: 600;
                text-decoration: none;
                cursor: pointer;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th {
                text-align: left;
                font-size: 11.5px;
                color: var(--muted);
                font-weight: 600;
                padding: 8px 6px;
                border-bottom: 1px solid var(--border);
                text-transform: none;
            }

            td {
                font-size: 13px;
                padding: 12px 6px;
                border-bottom: 1px solid var(--border);
                color: var(--navy-soft);
            }

                td.name {
                    font-weight: 600;
                    color: var(--navy);
                }

            tr:last-child td {
                border-bottom: none;
            }

            .icon-btn {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: var(--blue-soft);
                margin-right: 6px;
                cursor: pointer;
            }

            .dropdown {
                display: flex;
                align-items: center;
                gap: 6px;
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 6px 10px;
                font-size: 12.5px;
                font-weight: 600;
                color: var(--navy);
            }

            .chart-summary {
                display: flex;
                justify-content: space-between;
                margin-top: 16px;
                padding-top: 16px;
                border-top: 1px solid var(--border);
            }

                .chart-summary .item {
                    flex: 1;
                }

                    .chart-summary .item + .item {
                        border-left: 1px solid var(--border);
                        padding-left: 16px;
                    }

                .chart-summary .label {
                    font-size: 11.5px;
                    color: var(--muted);
                    margin-bottom: 4px;
                }

                .chart-summary .value {
                    font-size: 15px;
                    font-weight: 700;
                }
    </style>
</head>
<body>
    <div class="wrap">

        <!-- ============ HEADER ============ -->
        <div class="top-header">
            <div>
                <h1>Reports Overview</h1>
                <p>Track performance and generate insights across all hotel operations.</p>
            </div>
            <div class="header-controls">
                <div class="pill">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8993a4" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    <span>01 Aug 2026&nbsp;&nbsp;-&nbsp;&nbsp;16 Aug 2026</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8993a4" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                </div>
                <button class="btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#131b2e" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                    Filter
                </button>
                <button class="btn btn-primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                    Download Report
                </button>
            </div>
        </div>

        <!-- ============ ROW 1: KPI CARDS ============ -->
        <div class="grid-5" id="kpi-row"></div>

        <!-- ============ ROW 2: REPORT CARDS ============ -->
        <div class="grid-5" id="row2"></div>

        <!-- ============ ROW 3: REPORT CARDS ============ -->
        <div class="grid-5" id="row3"></div>

        <!-- ============ BOTTOM ============ -->
        <div class="bottom-grid">
            <div class="panel">
                <div class="panel-head">
                    <h2>Recent Generated Reports</h2>
                    <a class="link">View All</a>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Report Name</th>
                            <th>Type</th>
                            <th>Date Range</th>
                            <th>Generated On</th>
                            <th>Generated By</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="table-body"></tbody>
                </table>
            </div>

            <div class="panel">
                <div class="panel-head">
                    <h2>Revenue Trend (This Month)</h2>
                    <div class="dropdown">
                        This Month
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#131b2e" stroke-width="3"><polyline points="6 9 12 15 18 9" /></svg>
                    </div>
                </div>
                <div id="trend-chart"></div>
                <div class="chart-summary">
                    <div class="item">
                        <div class="label">Total Revenue</div>
                        <div class="value">$284,920</div>
                    </div>
                    <div class="item">
                        <div class="label">Average Daily Revenue</div>
                        <div class="value">$17,807</div>
                    </div>
                    <div class="item">
                        <div class="label">Best Day</div>
                        <div class="value" style="font-size:13px;font-weight:600;">16 Aug 2026</div>
                        <div class="value">$59,250</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script>
            /* ---------------- ICONS ---------------- */
            const icons = {
              dollar:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
              calendar:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
              payment:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>',
              bed:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M2 18v-6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v6"/><path d="M2 18v2"/><path d="M22 18v2"/><path d="M4 10V6a2 2 0 0 1 2-2h5"/></svg>',
              broom:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round"><path d="M4 21l6-6"/><path d="M9.5 15.5L18 7a3 3 0 1 0-4-4l-8.5 8.5"/><path d="M6 18l3-3"/></svg>',
              bars:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><line x1="6" y1="20" x2="6" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="14"/></svg>',
              people:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
              doc:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',
              pie:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>',
              user:'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
              filedoc:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#131b2e" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',
              eye:'<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2f6feb" stroke-width="2.3"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
              download:'<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2f6feb" stroke-width="2.3"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>'
            };

            /* ---------------- SPARKLINE (SVG line chart) ---------------- */
            function sparkline(points, color){
              const w=220,h=52;
              const max=Math.max(...points), min=Math.min(...points);
              const stepX = w/(points.length-1);
              const coords = points.map((p,i)=>{
                const x = i*stepX;
                const y = h - ((p-min)/(max-min||1))*(h-8) - 4;
                return [x,y];
              });
              const line = coords.map((c,i)=> (i===0?'M':'L')+c[0].toFixed(1)+','+c[1].toFixed(1)).join(' ');
              const area = line + ` L${w},${h} L0,${h} Z`;
              const id = 'g'+Math.random().toString(36).slice(2,9);
              return `<svg width="100%" height="${h}" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
                <defs><linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="${color}" stop-opacity="0.25"/>
                  <stop offset="100%" stop-color="${color}" stop-opacity="0"/>
                </linearGradient></defs>
                <path d="${area}" fill="url(#${id})" stroke="none"/>
                <path d="${line}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>`;
            }

            /* ---------------- MINI BAR CHART ---------------- */
            function barChart(points, color){
              const w=220,h=44,gap=2;
              const barW = (w/points.length) - gap;
              const max = Math.max(...points);
              const bars = points.map((p,i)=>{
                const bh = (p/max)*h;
                const x = i*(barW+gap);
                const y = h-bh;
                return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${bh.toFixed(1)}" rx="1.5" fill="${color}" opacity="${0.35+ (p/max)*0.65}"/>`;
              }).join('');
              return `<svg width="100%" height="${h}" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">${bars}</svg>`;
            }

            function rand(seed){ // deterministic pseudo-random generator for consistent charts
              let s = seed;
              return ()=>{ s = (s*9301+49297)%233280; return s/233280; };
            }
            function series(seedNum, n, base, variance, uptrend=true){
              const r = rand(seedNum);
              let val = base;
              const out=[];
              for(let i=0;i<n;i++){
                val += (r()-0.42)*variance + (uptrend? variance*0.06:0);
                out.push(Math.max(val, base*0.3));
              }
              return out;
            }

            /* ---------------- KPI DATA ---------------- */
            const kpis = [
              {label:'Total Revenue', value:'$284,920', delta:'18.7%', icon:icons.dollar, color:'#2f6feb', soft:'var(--blue-soft)', data:series(11,14,120,18)},
              {label:'Total Bookings', value:'132', delta:'12.6%', icon:icons.calendar, color:'#1fb15f', soft:'var(--green-soft)', data:series(22,14,80,14)},
              {label:'Total Payments', value:'108', delta:'15.7%', icon:icons.payment, color:'#8b5cf6', soft:'var(--purple-soft)', data:series(33,14,70,12)},
              {label:'Occupancy', value:'78%', delta:'5.1%', icon:icons.bed, color:'#f2994a', soft:'var(--orange-soft)', data:series(44,14,60,10)},
              {label:'Housekeeping Tasks', value:'452', delta:'12.6%', icon:icons.broom, color:'#17b6c4', soft:'var(--cyan-soft)', data:series(55,14,300,30)}
            ];

            const kpiRow = document.getElementById('kpi-row');
            kpis.forEach(k=>{
              kpiRow.innerHTML += `
              <div class="kpi-card">
                <div class="kpi-top">
                  <div class="icon-circle" style="background:${k.color}">${k.icon}</div>
                  <div class="kpi-label">${k.label}</div>
                </div>
                <div class="kpi-value">${k.value}</div>
                <div class="kpi-delta">↑ ${k.delta} <span>vs last 16 days</span></div>
                ${sparkline(k.data, k.color)}
              </div>`;
            });

            /* ---------------- REPORT CARDS DATA ---------------- */
            const row2 = [
              {title:'Revenue Report', desc:'View revenue summary, room income, taxes and other changes.', value:'$284,920', delta:'18.7%', color:'#2f6feb', icon:icons.bars, data:series(1,16,50,25), chart:'bar', action:'/Reports/Revenue'},
              {title:'Booking Report', desc:'Track bookings, check-ins, check-outs and cancellations.', value:'132', delta:'12.6%', color:'#1fb15f', icon:icons.calendar, data:series(2,16,50,25), chart:'bar', action:'/Reports/Booking'},
              {title:'Payment Report', desc:'View payments received, pending, failed and refunded.', value:'108', delta:'15.7%', color:'#8b5cf6', icon:icons.payment, data:series(3,16,50,25), chart:'bar', action:'/Reports/Payment'},
              {title:'Room Report', desc:'Get insights on room status, occupancy and availability.', value:'120', delta:'8.3%', color:'#f2994a', icon:icons.bed, data:series(4,16,50,25), chart:'bar', action:'/Reports/Room'},
              {title:'Housekeeping Report', desc:'Track housekeeping tasks, performance and task status.', value:'452', delta:'12.6%', color:'#17b6c4', icon:icons.broom, data:series(5,16,50,25), chart:'bar', action:'/Reports/Housekeeping'}
            ];

            const row3 = [
              {title:'Customer Report', desc:'View guest details, booking history and demographics.', value:'320', delta:'10.3%', color:'#8b5cf6', icon:icons.people, data:series(6,16,50,25), chart:'bar', action:'/Reports/Customer'},
              {title:'Billing Report', desc:'View all bills, taxes, discounts and outstanding amounts.', value:'186', delta:'14.8%', color:'#f2994a', icon:icons.doc, data:series(7,16,50,25), chart:'bar', action:'/Reports/Billing'},
              {title:'Occupancy Report', desc:'Daily, weekly and monthly occupancy analysis', value:'78%', delta:'5.1%', color:'#1fb15f', icon:icons.pie, data:series(8,14,55,10), chart:'line', action:'/Reports/Occupancy'},
              {title:'Staff Performance', desc:'Track staff performance and productivity metrics.', value:'28', delta:'9.4%', color:'#2f6feb', icon:icons.user, data:series(9,14,55,10), chart:'line', action:'/Reports/StaffPerformance'},
              {title:'Custom Report', desc:'Generate custom reports based on your filters.', value:null, delta:null, color:'#131b2e', icon:icons.filedoc, custom:true, action:'/Reports/Custom'}
            ];

            function iconCircleSoft(color){
              return `background:${color}1a`;
            }

            function renderReportCard(r){
                if(r.custom){
                return `
                <div class="report-card">
                  <div class="report-top">
                    <div class="icon-circle" style="background:#eef0f5">${r.icon}</div>
                    <h3 class="report-title">${r.title}</h3>
                  </div>
                  <p class="report-desc">${r.desc}</p>
                  <div class="custom-preview">
                    <div class="bars">
                      <div style="height:35%"></div>
                      <div style="height:60%"></div>
                      <div style="height:45%"></div>
                      <div style="height:80%"></div>
                      <div style="height:55%"></div>
                      <div style="height:70%"></div>
                    </div>
                    <div class="custom-dots">
                      <span style="background:#2f6feb"></span>
                      <span style="background:#f2994a"></span>
                      <span style="background:#1fb15f"></span>
                    </div>
                  </div>
                  <a href="${r.action}" class="view-btn">Create Report</a>
                </div>`;
              }
              const chart = r.chart==='bar' ? barChart(r.data, r.color) : sparkline(r.data, r.color);
              return `
              <div class="report-card">
                <div class="report-top">
                  <div class="icon-circle" style="background:${r.color}">${r.icon}</div>
                  <h3 class="report-title">${r.title}</h3>
                </div>
                <p class="report-desc">${r.desc}</p>
                <div class="report-metrics">
                  <div class="report-value">${r.value}</div>
                  <div class="report-delta">↑ ${r.delta}</div>
                </div>
                ${chart}
                <a href="${r.action}" class="view-btn">View Report</a>
              </div>`;
            }

            document.getElementById('row2').innerHTML = row2.map(renderReportCard).join('');
            document.getElementById('row3').innerHTML = row3.map(renderReportCard).join('');

            /* ---------------- TABLE ---------------- */
            const rows = [
              ['Housekeeping Report','Housekeeping','01 Aug 2026 - 16 Aug 2026','16 Aug 2026 11:30 AM','Admin'],
              ['Revenue Report','Revenue','01 Aug 2026 - 16 Aug 2026','16 Aug 2026 10:15 AM','Admin'],
              ['Booking Report','Booking','01 Aug 2026 - 16 Aug 2026','16 Aug 2026 09:45 AM','Admin'],
              ['Payment Report','Payment','01 Aug 2026 - 16 Aug 2026','16 Aug 2026 06:20 PM','Admin'],
              ['Room Report','Room','01 Aug 2026 - 16 Aug 2026','16 Aug 2026 04:05 PM','Admin']
            ];
            document.getElementById('table-body').innerHTML = rows.map(r=>`
              <tr>
                <td class="name">${r[0]}</td>
                <td>${r[1]}</td>
                <td>${r[2]}</td>
                <td>${r[3]}</td>
                <td>${r[4]}</td>
                <td>
                  <span class="icon-btn">${icons.eye}</span>
                  <span class="icon-btn">${icons.download}</span>
                </td>
              </tr>
            `).join('');

            /* ---------------- REVENUE TREND CHART ---------------- */
            function revenueTrendChart(){
              const w=560, h=210, padL=40, padB=24, padT=10, padR=6;
              const xLabels = ['01 Aug','04 Aug','07 Aug','10 Aug','13 Aug','16 Aug'];
              const yMax = 60000;
              // 16 days of data trending up to 59250 with dips, matching reference silhouette
              const data = [3200,8500,12000,15500,14000,18500,22000,26500,29500,32000,42000,48500,45000,41500,44000,59250];
              const plotW = w-padL-padR, plotH = h-padT-padB;
              const stepX = plotW/(data.length-1);
              const coords = data.map((v,i)=>{
                const x = padL + i*stepX;
                const y = padT + plotH - (v/yMax)*plotH;
                return [x,y];
              });
              const line = coords.map((c,i)=>(i===0?'M':'L')+c[0].toFixed(1)+','+c[1].toFixed(1)).join(' ');
              const area = line + ` L${(padL+plotW).toFixed(1)},${(padT+plotH).toFixed(1)} L${padL},${(padT+plotH).toFixed(1)} Z`;

              const yGrid = [0,10000,20000,30000,40000,50000,60000];
              let gridLines = '', yLabels='';
              yGrid.forEach(v=>{
                const y = padT + plotH - (v/yMax)*plotH;
                gridLines += `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${padL+plotW}" y2="${y.toFixed(1)}" stroke="#eef0f5" stroke-width="1"/>`;
                yLabels += `<text x="${padL-8}" y="${(y+3).toFixed(1)}" font-size="10" fill="#8993a4" text-anchor="end">$${v/1000}${v===0?'0':'K'}</text>`;
              });

              let xLabelsSvg='';
              const xIdx = [0,3,6,9,12,15];
              xIdx.forEach((di,i)=>{
                const x = padL + di*stepX;
                xLabelsSvg += `<text x="${x.toFixed(1)}" y="${h-6}" font-size="10" fill="#8993a4" text-anchor="middle">${xLabels[i]}</text>`;
              });

              const dots = coords.map(c=>`<circle cx="${c[0].toFixed(1)}" cy="${c[1].toFixed(1)}" r="2.5" fill="#2f6feb"/>`).join('');

              return `<svg width="100%" height="${h}" viewBox="0 0 ${w} ${h}">
                <defs><linearGradient id="trendfill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#2f6feb" stop-opacity="0.22"/>
                  <stop offset="100%" stop-color="#2f6feb" stop-opacity="0"/>
                </linearGradient></defs>
                ${gridLines}
                ${yLabels}
                ${xLabelsSvg}
                <path d="${area}" fill="url(#trendfill)" stroke="none"/>
                <path d="${line}" fill="none" stroke="#2f6feb" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/>
                ${dots}
              </svg>`;
            }
            document.getElementById('trend-chart').innerHTML = revenueTrendChart();
    </script>
</body>
</html>
