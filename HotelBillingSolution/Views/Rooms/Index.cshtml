        .rooms-header__actions {
            justify-content: flex-start;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

       
        .filter-card__row {
            flex-wrap: nowrap;
        }

        .table-card__footer {
            flex-direction: column;
            align-items: flex-start;
        }
