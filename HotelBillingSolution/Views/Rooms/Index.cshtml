</style>

<script>
    

    (function () {
        "use strict";

        document.addEventListener("DOMContentLoaded", init);

        function init() {
            const table = document.getElementById("roomsTable");
            if (!table) return;

            const tbody = document.getElementById("roomsTableBody");
            const rows = () => Array.from(tbody.querySelectorAll("tr"));

            const searchInput = document.getElementById("roomSearch");
            const quickSearchInput = document.getElementById("tableQuickSearch");
            const typeSelect = document.getElementById("filterRoomType");
            const statusSelect = document.getElementById("filterStatus");
            const floorSelect = document.getElementById("filterFloor");
            const priceSelect = document.getElementById("filterPrice");
            const resetBtn = document.getElementById("btnResetFilter");
            const searchBtn = document.getElementById("btnSearchFilter");
            const countLabel = document.getElementById("roomsCountLabel");
            const sortableHeaders = table.querySelectorAll("th.sortable");

            let sortState = { key: null, dir: 1 };

            // ---------- FILTERING ----------
            function applyFilters() {
                const term = ((searchInput && searchInput.value) || (quickSearchInput && quickSearchInput.value) || "")
                    .trim()
                    .toLowerCase();
                const type = typeSelect ? typeSelect.value : "";
                const status = statusSelect ? statusSelect.value : "";
                const floor = floorSelect ? floorSelect.value : "";
                const priceRange = priceSelect ? priceSelect.value : "";

                let [minPrice, maxPrice] = priceRange ? priceRange.split("-").map(Number) : [null, null];

                let visibleCount = 0;

                rows().forEach((row) => {
                    const roomNo = row.dataset.roomNo || "";
                    const roomType = row.dataset.roomType || "";
                    const roomStatus = row.dataset.status || "";
                    const roomFloor = row.dataset.floor || "";
                    const roomPrice = Number(row.dataset.price || 0);
                    const rowText = row.textContent.toLowerCase();

                    let visible = true;

                    if (term && !rowText.includes(term)) visible = false;
                    if (type && roomType !== type) visible = false;
                    if (status && roomStatus !== status) visible = false;
                    if (floor && roomFloor !== floor) visible = false;
                    if (priceRange && (roomPrice < minPrice || roomPrice > maxPrice)) visible = false;

                    row.style.display = visible ? "" : "none";
                    if (visible) visibleCount++;
                });

                updateCountLabel(visibleCount);
            }

            function updateCountLabel(visibleCount) {
                if (!countLabel) return;
                const total = rows().length;
                const shown = Math.min(visibleCount, total);
                countLabel.textContent = `Showing ${shown === 0 ? 0 : 1} to ${shown} of ${total} rooms`;
            }

            function resetFilters() {
                if (searchInput) searchInput.value = "";
                if (quickSearchInput) quickSearchInput.value = "";
                if (typeSelect) typeSelect.value = "";
                if (statusSelect) statusSelect.value = "";
                if (floorSelect) floorSelect.value = "";
                if (priceSelect) priceSelect.value = "";
                applyFilters();
            }

            if (searchInput) searchInput.addEventListener("input", debounce(applyFilters, 200));
            if (quickSearchInput) quickSearchInput.addEventListener("input", debounce(applyFilters, 200));
            [typeSelect, statusSelect, floorSelect, priceSelect].forEach((el) => {
                if (el) el.addEventListener("change", applyFilters);
            });
            if (resetBtn) resetBtn.addEventListener("click", resetFilters);
            if (searchBtn) searchBtn.addEventListener("click", applyFilters);

            // ---------- SORTING ----------
            sortableHeaders.forEach((th) => {
                th.addEventListener("click", () => {
                    const key = th.dataset.sort;
                    sortState.dir = sortState.key === key ? sortState.dir * -1 : 1;
                    sortState.key = key;

                    sortableHeaders.forEach((h) => h.querySelector("i").className = "fa-solid fa-sort");
                    const icon = th.querySelector("i");
                    icon.className = sortState.dir === 1 ? "fa-solid fa-sort-up" : "fa-solid fa-sort-down";

                    sortRows(key, sortState.dir);
                });
            });

            function sortRows(key, dir) {
                const map = {
                    roomNo: (r) => Number(r.dataset.roomNo),
                    roomName: (r) => r.children[2].textContent.trim().toLowerCase(),
                    roomType: (r) => r.dataset.roomType,
                    floor: (r) => Number(r.dataset.floor),
                    price: (r) => Number(r.dataset.price),
                    created: (r) => new Date(r.children[9].textContent.trim())
                };
                const getValue = map[key];
                if (!getValue) return;

                const sorted = rows().sort((a, b) => {
                    const va = getValue(a);
                    const vb = getValue(b);
                    if (va < vb) return -1 * dir;
                    if (va > vb) return 1 * dir;
                    return 0;
                });

                sorted.forEach((row) => tbody.appendChild(row));
            }

            // ---------- PAGINATION (demo only — hooks up to real paging later) ----------
            const pagination = document.getElementById("roomsPagination");
            if (pagination) {
                pagination.addEventListener("click", (e) => {
                    const link = e.target.closest(".page-link");
                    if (!link) return;
                    e.preventDefault();

                    const items = Array.from(pagination.querySelectorAll(".page-item"));
                    const current = pagination.querySelector(".page-item.active");

                    items.forEach((li) => li.classList.remove("active"));
                    const parentLi = link.closest(".page-item");
                    if (parentLi && link.dataset.page !== "prev" && link.dataset.page !== "next") {
                        parentLi.classList.add("active");
                    }
                    // Real implementation: fetch page data via AJAX from RoomsController
                    // and re-render tbody + countLabel accordingly.
                });
            }

            // ---------- ROWS PER PAGE ----------
            const rowsPerPage = document.getElementById("rowsPerPage");
            if (rowsPerPage) {
                rowsPerPage.addEventListener("change", () => {
                    // Hook into server-side paging with rowsPerPage.value
                    applyFilters();
                });
            }

            // ---------- UTIL ----------
            function debounce(fn, delay) {
                let timer;
                return function (...args) {
                    clearTimeout(timer);
                    timer = setTimeout(() => fn.apply(this, args), delay);
                };
            }

            // Initial count
            updateCountLabel(rows().length);

            // Update summary cards using rendered rows (derived from DB)
            function updateSummaryCards() {
                const all = rows();
                const total = all.length;
                const available = all.filter(r => (r.dataset.status || '').toLowerCase().includes('available')).length;
                const occupied = all.filter(r => (r.dataset.status || '').toLowerCase().includes('occupied')).length;
                const maintenance = all.filter(r => (r.dataset.status || '').toLowerCase().includes('maintenance')).length;

                const elTotal = document.getElementById('totalRoomsCount');
                const elAvail = document.getElementById('availableRoomsCount');
                const elOcc = document.getElementById('occupiedRoomsCount');
                const elMaint = document.getElementById('maintenanceRoomsCount');

                if (elTotal) elTotal.textContent = total;
                if (elAvail) elAvail.textContent = available;
                if (elOcc) elOcc.textContent = occupied;
                if (elMaint) elMaint.textContent = maintenance;
            }

            updateSummaryCards();
        }
    })();

</script>
