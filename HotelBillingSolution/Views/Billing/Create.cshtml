<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- trailing script placeholder: keep this line to ensure build tools preserve trailing scripts -->
<script>
    (function () {
    const itemsTableBody = document.querySelector('#itemsTable tbody');
    const btnAddItem = document.getElementById('btnAddItem');
    const qaAddItem = document.getElementById('qaAddItem');
    const totalItemsCountEl = document.getElementById('totalItemsCount');
    const totalItemsAmountEl = document.getElementById('totalItemsAmount');

    const taxPercentInput = document.getElementById('taxPercent');
    const discountPercentInput = document.getElementById('discountPercent');
    const advanceReceivedInput = document.getElementById('advanceReceived');
    const checkInInput = document.getElementById('checkIn');
    const checkOutInput = document.getElementById('checkOut');
    const nightsInput = document.getElementById('nights');

    const paymentMethodInput = document.getElementById('paymentMethod');
    const transactionNumberInput = document.getElementById('transactionNumber');
    const paymentDateInput = document.getElementById('paymentDate');
    const paymentStatusInput = document.getElementById('paymentStatus');

    const serviceCharge = 250.00;

    function formatCurrency(value) {
    return '₹' + value.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatDisplayDate(value) {
    if (!value) return '—';
    const d = new Date(value);
    if (isNaN(d)) return '—';
    return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function reindexRows() {
    const rows = itemsTableBody.querySelectorAll('tr');
    rows.forEach((row, idx) => {
    row.querySelector('.row-index').textContent = idx + 1;
    });
    }

    function calculateNights() {
    const inDate = new Date(checkInInput.value);
    const outDate = new Date(checkOutInput.value);
    if (!isNaN(inDate) && !isNaN(outDate) && outDate > inDate) {
    const diffTime = outDate - inDate;
    const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
    nightsInput.value = diffDays;
    }
    }

    function statusBadgeClass(status) {
    switch (status) {
    case 'Paid': return 'badge-paid';
    case 'Partially Paid': return 'badge-partial';
    default: return 'badge-pending';
    }
    }

    function recalculateAll() {
    let subtotal = 0;
    let itemCount = 0;

    itemsTableBody.querySelectorAll('tr').forEach(row => {
    const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
    const rate = parseFloat(row.querySelector('.item-rate').value) || 0;
    const amount = qty * rate;
    row.querySelector('.row-amount').textContent = formatCurrency(amount);
    subtotal += amount;
    itemCount++;
    });

    const discountPct = parseFloat(discountPercentInput.value) || 0;
    const taxPct = parseFloat(taxPercentInput.value) || 0;
    const advance = parseFloat(advanceReceivedInput.value) || 0;

    const discountAmt = subtotal * (discountPct / 100);
    const taxableAmt = subtotal - discountAmt;
    const taxAmt = taxableAmt * (taxPct / 100);
    const total = taxableAmt + taxAmt + serviceCharge;
    const due = total - advance;

    totalItemsCountEl.textContent = itemCount;
    totalItemsAmountEl.textContent = formatCurrency(subtotal);

    document.getElementById('sumSubtotal').textContent = formatCurrency(subtotal);
    document.getElementById('sumDiscount').textContent = '- ' + formatCurrency(discountAmt);
    document.getElementById('sumTax').textContent = '+ ' + formatCurrency(taxAmt);
    document.getElementById('sumService').textContent = '+ ' + formatCurrency(serviceCharge);
    document.getElementById('sumTotal').textContent = formatCurrency(total);
    document.getElementById('sumPaid').textContent = formatCurrency(advance);
    document.getElementById('sumDue').textContent = formatCurrency(due > 0 ? due : 0);

    document.getElementById('sumPaid2').textContent = formatCurrency(advance);
    }

    function syncPaymentSummary() {
    document.getElementById('sumMethod').textContent = paymentMethodInput.value;
    document.getElementById('sumTxn').textContent = transactionNumberInput.value || '—';
    document.getElementById('sumPayDate').textContent = formatDisplayDate(paymentDateInput.value);

    const badge = document.getElementById('sumStatusBadge');
    badge.textContent = paymentStatusInput.value;
    badge.classList.remove('badge-pending', 'badge-paid', 'badge-partial');
    badge.classList.add(statusBadgeClass(paymentStatusInput.value));
    }

    function addItemRow() {
    const row = document.createElement('tr');
    row.innerHTML = `
    <td class="row-index"></td>
    <td><input type="text" class="item-name" value="New Item" /></td>
    <td><input type="number" class="item-qty" value="1" /></td>
    <td><input type="number" class="item-rate" value="0" /></td>
    <td class="row-amount">₹0.00</td>
    <td><button type="button" class="btn-del-row"><i class="fa-solid fa-trash"></i></button></td>
    `;
    itemsTableBody.appendChild(row);
    reindexRows();
    recalculateAll();
    }

    itemsTableBody.addEventListener('input', function (e) {
    if (e.target.classList.contains('item-qty') || e.target.classList.contains('item-rate')) {
    recalculateAll();
    }
    });

    itemsTableBody.addEventListener('click', function (e) {
    const delBtn = e.target.closest('.btn-del-row');
    if (delBtn) {
    const row = delBtn.closest('tr');
    if (itemsTableBody.querySelectorAll('tr').length > 1) {
    row.remove();
    reindexRows();
    recalculateAll();
    }
    }
    });

    btnAddItem.addEventListener('click', addItemRow);
    qaAddItem.addEventListener('click', addItemRow);
    qaAddItem.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); addItemRow(); }
    });

    [taxPercentInput, discountPercentInput, advanceReceivedInput].forEach(el => {
    el.addEventListener('input', recalculateAll);
    });

    [checkInInput, checkOutInput].forEach(el => {
    el.addEventListener('change', calculateNights);
    });

    [paymentMethodInput, transactionNumberInput, paymentDateInput, paymentStatusInput].forEach(el => {
    el.addEventListener('input', syncPaymentSummary);
    el.addEventListener('change', syncPaymentSummary);
    });

    document.getElementById('btnSaveBill').addEventListener('click', function () {
    recalculateAll();
    alert('Bill saved successfully! (Wire this button to your MVC controller action.)');
    });
    document.getElementById("btnBackToList").addEventListener("click", function () {
    window.location.href = "/Billing/Index";
    });

    // Initial calculation on load
    recalculateAll();
    syncPaymentSummary();
    })();
</script>
