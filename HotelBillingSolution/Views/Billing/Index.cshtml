@{
    ViewData["Title"] = "Billing";
}

@using System.Linq
@using HotelBilling.Application.DTOs.Bill
@using HotelBilling.Application.DTOs.Customer
@using HotelBilling.Application.DTOs.Room
@model IEnumerable<BillDto>

@{
    // ---- Aggregates computed from the real Model (no more hardcoded dummy numbers) ----
    var totalAmountSum = Model != null && Model.Any() ? Model.Sum(b => b.TotalAmount) : 0m;
    var dueAmountSum = Model != null && Model.Any() ? Model.Sum(b => b.DueAmount) : 0m;
    var paidAmountSum = totalAmountSum - dueAmountSum;
}

<style>
    /* ===================== Billing Page Scoped Styles ===================== */
    /* Use shared tokens from site.css for colors/surfaces/ borders */
    .billing-page {
        --bp-primary: var(--primary-color);
        --bp-primary-dark: var(--primary-color-2);
        --bp-primary-light: color-mix(in srgb, var(--card-color) 88%, var(--primary-color) 12%);
        --bp-green: var(--success-color);
        --bp-green-light: var(--success-soft);
        --bp-orange: var(--warning-color);
        --bp-orange-light: var(--warning-soft);
        --bp-red: var(--danger-color);
        --bp-red-light: var(--danger-soft);
        --bp-purple: #7C3AED;
        --bp-purple-light: color-mix(in srgb, var(--card-color) 88%, #7C3AED 12%);
        --bp-blue-badge: var(--primary-color);
        --bp-blue-light: color-mix(in srgb, var(--card-color) 88%, var(--primary-color) 12%);
        --bp-text: var(--text-color);
        --bp-text-muted: var(--text-muted);
        --bp-border: var(--border-color);
        --bp-radius: 18px;
        --bp-shadow: var(--shadow-sm);
        --bp-shadow-hover: var(--shadow-md);
        color: var(--text-color);
        font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
    }

        .billing-page * {
            box-sizing: border-box;
        }

        .billing-page .bp-card {
            background: var(--card-color);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            border: 1px solid var(--bp-border);
            border-radius: var(--bp-radius);
            box-shadow: var(--bp-shadow);
            transition: box-shadow .25s ease, transform .25s ease;
        }

            .billing-page .bp-card:hover {
                box-shadow: var(--bp-shadow-hover);
            }

    /* ---- Page Header ---- */
    .bp-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

        .bp-header h1 {
            font-size: 1.65rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin: 0 0 4px 0;
            color: var(--bp-text);
        }

        .bp-header p {
            margin: 0;
            color: var(--bp-text-muted);
            font-size: 0.92rem;
        }

    .bp-header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .bp-btn {
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.86rem;
        padding: 0.55rem 1.1rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s ease;
        border: 1px solid transparent;
        white-space: nowrap;
        cursor: pointer;
    }

    .bp-btn-outline {
        background: var(--input-color);
        border-color: var(--bp-border);
        color: var(--bp-text);
    }

        .bp-btn-outline:hover {
            border-color: var(--bp-primary);
            color: var(--bp-primary);
            transform: translateY(-1px);
        }

    .bp-btn-primary {
        background: linear-gradient(135deg, var(--bp-primary), var(--bp-primary-dark));
        color: var(--on-primary, #fff);
        border: none;
        box-shadow: 0 8px 18px color-mix(in srgb, var(--bp-primary) 40%, transparent);
    }

        .bp-btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 22px color-mix(in srgb, var(--bp-primary) 50%, transparent);
            color: var(--on-primary, #fff);
        }

    /* ---- Filter Card ---- */
    .bp-filter-card {
        padding: 20px 22px;
        margin-bottom: 22px;
    }

    .bp-filter-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .bp-field label {
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--bp-text-muted);
        margin-bottom: 6px;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .bp-field .form-control,
    .bp-field .form-select {
        border-radius: 10px;
        border: 1px solid var(--bp-border);
        font-size: 0.88rem;
        padding: 0.5rem 0.75rem;
        background-color: var(--input-color);
        color: var(--text-color);
    }

        .bp-field .form-control::placeholder {
            color: var(--bp-text-muted);
            opacity: .75;
        }

        .bp-field .form-control:focus,
        .bp-field .form-select:focus {
            border-color: var(--bp-primary);
            box-shadow: 0 0 0 3px var(--primary-soft);
            background-color: var(--input-color);
            color: var(--text-color);
        }

        .bp-field .form-select option {
            background: var(--card-color);
            color: var(--text-color);
        }

    .bp-input-icon {
        position: relative;
    }

        .bp-input-icon i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--bp-text-muted);
            font-size: 0.82rem;
        }

        .bp-input-icon input {
            padding-left: 32px;
        }

    .bp-filter-actions {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

        .bp-filter-actions .bp-btn {
            width: 100%;
            justify-content: center;
        }

    /* ---- Stat Cards ---- */
    .bp-stats-row {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .bp-stat-card {
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .bp-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

        .bp-stat-icon.blue {
            background: var(--bp-primary-light);
            color: var(--bp-primary);
        }

        .bp-stat-icon.green {
            background: var(--bp-green-light);
            color: var(--bp-green);
        }

        .bp-stat-icon.orange {
            background: var(--bp-orange-light);
            color: var(--bp-orange);
        }

        .bp-stat-icon.red {
            background: var(--bp-red-light);
            color: var(--bp-red);
        }

        .bp-stat-icon.purple {
            background: var(--bp-purple-light);
            color: var(--bp-purple);
        }

    .bp-stat-label {
        font-size: 0.78rem;
        color: var(--bp-text-muted);
        font-weight: 600;
        margin-bottom: 2px;
    }

    .bp-stat-value {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--bp-text);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .bp-stat-sub {
        font-size: 0.74rem;
        color: var(--bp-text-muted);
        margin-top: 2px;
    }

    /* ---- Main Layout ---- */
    .bp-main-row {
        display: grid;
        grid-template-columns: 75% 25%;
        gap: 20px;
        align-items: start;
    }

    @@media (max-width: 1199.98px) {
        .bp-main-row {
            grid-template-columns: 1fr;
        }

        .bp-stats-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .bp-filter-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 575.98px) {
        .bp-stats-row {
            grid-template-columns: 1fr;
        }

        .bp-filter-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ---- Billing List Card ---- */
    .bp-list-card {
        padding: 20px 22px 8px 22px;
    }

    .bp-list-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 10px;
    }

        .bp-list-card-head h5 {
            font-weight: 700;
            font-size: 1.05rem;
            margin: 0;
            color: var(--bp-text);
        }

    .bp-show-entries {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        color: var(--bp-text-muted);
    }

        .bp-show-entries select {
            border-radius: 8px;
            border: 1px solid var(--bp-border);
            padding: 0.3rem 0.6rem;
            font-size: 0.82rem;
            background: var(--input-color);
            color: var(--text-color);
        }

    .bp-table-wrap {
        overflow-x: auto;
    }

    table.bp-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 900px;
        color: var(--bp-text);
    }

        table.bp-table thead th {
            text-transform: uppercase;
            font-size: 0.70rem;
            letter-spacing: 0.04em;
            color: var(--bp-text-muted);
            font-weight: 700;
            border-bottom: 1px solid var(--bp-border);
            padding: 10px 12px;
            white-space: nowrap;
            background: var(--card-color-2);
        }

        table.bp-table tbody tr {
            background: var(--card-color);
            transition: background .18s ease;
        }

        table.bp-table tbody td {
            padding: 14px 12px;
            font-size: 0.86rem;
            border-bottom: 1px solid var(--bp-border);
            vertical-align: middle;
            white-space: nowrap;
            color: var(--bp-text);
            background: transparent;
        }

        table.bp-table tbody tr:hover {
            background: color-mix(in srgb, var(--card-color) 85%, var(--bp-primary) 15%);
        }

        table.bp-table tbody tr:last-child td {
            border-bottom: none;
        }

    .bp-invoice-no {
        font-weight: 700;
        color: var(--bp-primary);
    }

    .bp-guest {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .bp-guest-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--bp-primary), #60A5FA);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.78rem;
        flex-shrink: 0;
    }

    .bp-guest-name {
