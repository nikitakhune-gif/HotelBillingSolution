        }

    .bp-badge-pending {
        background: var(--bp-red-light);
        color: var(--bp-red);
    }

        .bp-badge-pending::before {
            background: var(--bp-red);
        }

    .bp-badge-completed {
        background: var(--bp-green-light);
        color: var(--bp-green);
    }

        .bp-badge-completed::before {
            background: var(--bp-green);
        }

    .bp-badge-checkedout {
        background: var(--bp-blue-light);
        color: var(--bp-blue-badge);
    }

        .bp-badge-checkedout::before {
            background: var(--bp-blue-badge);
        }

    .bp-badge-due {
        background: var(--bp-orange-light);
        color: var(--bp-orange);
    }

        .bp-badge-due::before {
            background: var(--bp-orange);
        }

    .bp-action-group {
        display: flex;
        gap: 6px;
    }

    .bp-icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        border: 1px solid var(--bp-border);
        background: var(--input-color);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--bp-text-muted);
        font-size: 0.8rem;
        transition: all .18s ease;
    }

        .bp-icon-btn:hover {
            background: var(--bp-primary);
            border-color: var(--bp-primary);
            color: #fff;
            transform: translateY(-1px);
        }

    /* ---- Pagination ---- */
    .bp-table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0 18px 0;
        flex-wrap: wrap;
        gap: 12px;
    }

    .bp-rows-per-page {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        color: var(--bp-text-muted);
    }

        .bp-rows-per-page select {
            border-radius: 8px;
            border: 1px solid var(--bp-border);
            padding: 0.3rem 0.6rem;
            font-size: 0.82rem;
            background: var(--input-color);
            color: var(--text-color);
        }

    .bp-pagination {
        display: flex;
        align-items: center;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .bp-pagination .page-item {
            display: inline-flex;
        }

        .bp-pagination .page-link {
            border: 1px solid var(--bp-border);
            border-radius: 10px;
            background: var(--input-color);
            color: var(--bp-text);
            font-size: 0.82rem;
            font-weight: 600;
            padding: 0.42rem 0.72rem;
            transition: all .18s ease;
            text-decoration: none;
        }

        .bp-pagination .page-item.active .page-link {
            background: var(--bp-primary);
            border-color: var(--bp-primary);
            color: #fff;
        }

        .bp-pagination .page-link:hover {
            border-color: var(--bp-primary);
            color: var(--bp-primary);
        }

        .bp-pagination .page-item.disabled .page-link {
            color: var(--bp-text-muted);
            opacity: .55;
            pointer-events: none;
        }

    /* ---- Right Sidebar Cards ---- */
    .bp-side-card {
        padding: 20px 22px;
        margin-bottom: 20px;
    }

        .bp-side-card h6 {
            font-weight: 700;
            font-size: 0.98rem;
            margin-bottom: 16px;
            color: var(--bp-text);
        }

    .bp-summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.86rem;
        color: var(--bp-text-muted);
        margin-bottom: 12px;
    }

        .bp-summary-row span.bp-val {
            color: var(--bp-text);
            font-weight: 600;
        }

        .bp-summary-row .text-success-val {
            color: var(--bp-green) !important;
        }

    .bp-divider {
        border: none;
        border-top: 1px dashed var(--bp-border);
        margin: 14px 0;
    }

    .bp-total-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .bp-total-label {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--bp-text);
    }

    .bp-total-value {
        font-weight: 800;
        font-size: 1.3rem;
        color: var(--bp-primary);
        letter-spacing: -0.02em;
    }

    .bp-paid-due {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .bp-mini-box {
        border-radius: 12px;
        padding: 10px 12px;
        text-align: center;
    }

        .bp-mini-box.paid {
            background: var(--bp-green-light);
        }

        .bp-mini-box.due {
            background: var(--bp-red-light);
        }

        .bp-mini-box .bp-mini-label {
            font-size: 0.70rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-bottom: 4px;
        }

        .bp-mini-box.paid .bp-mini-label {
            color: var(--bp-green);
        }

        .bp-mini-box.due .bp-mini-label {
            color: var(--bp-red);
        }

        .bp-mini-box .bp-mini-value {
            font-weight: 800;
            font-size: 0.98rem;
        }

        .bp-mini-box.paid .bp-mini-value {
            color: var(--bp-green);
        }

        .bp-mini-box.due .bp-mini-value {
            color: var(--bp-red);
        }

    /* ---- Bottom side row: Quick Actions + Payment Methods side-by-side ---- */
    .bp-side-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

        .bp-side-row .bp-side-card {
            margin-bottom: 0;
        }

    @@media (max-width: 767.98px) {
        .bp-side-row {
            grid-template-columns: 1fr;
        }
    }

    /* ---- Quick Actions / Payment Methods: clean list rows (matches the
               Payment Summary / Payment Methods styling used elsewhere in the app) ---- */
    .bp-quick-actions,
    .bp-payment-methods {
        display: flex;
        flex-direction: column;
    }

    .bp-quick-action-btn,
    .bp-payment-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 4px;
        border: none;
        border-bottom: 1px solid var(--bp-border);
        background: transparent;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--bp-text);
        transition: background-color .15s ease, padding-left .15s ease;
        text-align: left;
        cursor: pointer;
        width: 100%;
        border-radius: 8px;
    }

        .bp-quick-action-btn:last-child,
        .bp-payment-item:last-child {
            border-bottom: none;
        }

        .bp-quick-action-btn:hover,
        .bp-payment-item:hover {
            background: var(--bp-primary-light);
            padding-left: 10px;
        }

    .bp-quick-action-icon,
    .bp-payment-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

        .bp-quick-action-icon.blue, .bp-payment-icon.blue {
            background: var(--bp-primary-light);
            color: var(--bp-primary);
        }

        .bp-quick-action-icon.green, .bp-payment-icon.green {
            background: var(--bp-green-light);
            color: var(--bp-green);
        }

        .bp-quick-action-icon.orange, .bp-payment-icon.orange {
            background: var(--bp-orange-light);
            color: var(--bp-orange);
        }

        .bp-quick-action-icon.purple, .bp-payment-icon.purple {
            background: var(--bp-purple-light);
            color: var(--bp-purple);
        }

        .bp-quick-action-icon.red, .bp-payment-icon.red {
            background: var(--bp-red-light);
            color: var(--bp-red);
        }

    .bp-quick-action-btn.primary {
        background: linear-gradient(135deg, var(--bp-primary), var(--bp-primary-dark));
        color: #fff;
        border-bottom: none;
        border-radius: 12px;
        margin-bottom: 8px;
        padding: 0.7rem 0.85rem;
    }

        .bp-quick-action-btn.primary .bp-quick-action-icon {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

        .bp-quick-action-btn.primary:hover {
            padding-left: 0.85rem;
            filter: brightness(1.05);
        }

    .bp-payment-name {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--bp-text);
        flex: 1;
    }

    .bp-empty-state {
        text-align: center;
        color: var(--bp-text-muted);
        padding: 10px;
    }
</style>

<div class="billing-page">

    <!-- ===================== PAGE HEADER ===================== -->
    <div class="bp-header">
        <div>
            <h1>Billing</h1>
            <p>Generate and manage customer bills and invoices.</p>
        </div>
        <div class="bp-header-actions">
            <button type="button" class="bp-btn bp-btn-outline" id="btnPrint">
                <i class="fa-solid fa-print"></i> Print
            </button>
            <button type="button" class="bp-btn bp-btn-outline" id="btnExport">
                <i class="fa-solid fa-download"></i> Export
            </button>
            <button type="button"
                    class="bp-btn bp-btn-primary"
                    id="btnNewBill">
                <i class="fa-solid fa-plus"></i>
                New Bill
            </button>

        </div>
    </div>

    <!-- ===================== FILTER CARD ===================== -->
    <div class="bp-card bp-filter-card">
        <div class="bp-filter-grid">
            <div class="bp-field bp-input-icon">
                <label for="fSearch">Search Invoice</label>
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="form-control" id="fSearch" placeholder="INV-2026-00125">
            </div>

            <div class="bp-field">
                <label for="fGuest">Guest</label>
                <select class="form-select" id="fGuest">
                    <option selected>All Guests</option>
                    @if (Model != null)
                    {
                        foreach (var guest in Model.Select(b => b.CustomerName).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct())
                        {
                            <option>@guest</option>
                        }
                    }
                </select>
            </div>

            <div class="bp-field">
                <label for="fRoom">Room Number</label>
                <select class="form-select" id="fRoom">
                    <option selected>All Rooms</option>
                    @if (Model != null)
                    {
                        foreach (var room in Model.Select(b => b.RoomNumber).Where(r => r != null).Distinct())
                        {
                            <option>@room</option>
                        }
                    }
                </select>
            </div>

            <div class="bp-field">
                <label for="fDateRange">Billing Date Range</label>
                <input type="text" class="form-control" id="fDateRange" placeholder="dd/mm/yyyy - dd/mm/yyyy">
            </div>

            <div class="bp-field">
                <label for="fPaymentStatus">Payment Status</label>
                <select class="form-select" id="fPaymentStatus">
                    <option selected>All</option>
                    <option>Paid</option>
                    <option>Partial</option>
                    <option>Pending</option>
                </select>
            </div>

            <div class="bp-field">
                <label for="fPaymentMethod">Payment Method</label>
                <select class="form-select" id="fPaymentMethod">
                    <option selected>All</option>
                    <option>Cash</option>
                    <option>Card</option>
                    <option>UPI</option>
                    <option>Net Banking</option>
                    <option>Wallet</option>
                </select>
            </div>

            <div class="bp-field">
                <label for="fBillStatus">Bill Status</label>
                <select class="form-select" id="fBillStatus">
                    <option selected>All</option>
                    <option>Completed</option>
                    <option>Checked Out</option>
                    <option>Due</option>
                </select>
            </div>

            <div class="bp-field bp-filter-actions">
                <button type="button" class="bp-btn bp-btn-outline" id="btnReset">
                    <i class="fa-solid fa-rotate-left"></i> Reset
                </button>
                <button type="button" class="bp-btn bp-btn-primary" id="btnSearch">
                    <i class="fa-solid fa-magnifying-glass"></i> Search
                </button>
            </div>
        </div>
    </div>

    <!-- ===================== STATISTICS SECTION ===================== -->
    <div class="bp-stats-row">
        <div class="bp-card bp-stat-card">
            <div class="bp-stat-icon blue"><i class="fa-solid fa-file-invoice"></i></div>
            <div>
                <div class="bp-stat-label">Total Bills</div>
                <div class="bp-stat-value">@Model.Count()</div>
                <div class="bp-stat-sub">All Time</div>
            </div>
        </div>

        <div class="bp-card bp-stat-card">
            <div class="bp-stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <div class="bp-stat-label">Paid Bills</div>
                <div class="bp-stat-value">@Model.Count(b => b.PaymentStatus != null && b.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase))</div>
                <div class="bp-stat-sub">@((Model.Count() == 0) ? "0%" : String.Format("{0:0.##}%", Model.Count(b => b.PaymentStatus != null && b.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase)) * 100.0 / Model.Count()))</div>
            </div>
        </div>

        <div class="bp-card bp-stat-card">
            <div class="bp-stat-icon orange"><i class="fa-solid fa-clock"></i></div>
            <div>
                <div class="bp-stat-label">Pending Bills</div>
                <div class="bp-stat-value">@Model.Count(b => b.PaymentStatus != null && b.PaymentStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase))</div>
                <div class="bp-stat-sub">@((Model.Count() == 0) ? "0%" : String.Format("{0:0.##}%", Model.Count(b => b.PaymentStatus != null && b.PaymentStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase)) * 100.0 / Model.Count()))</div>
            </div>
        </div>

        <div class="bp-card bp-stat-card">
            <div class="bp-stat-icon red"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div>
                <div class="bp-stat-label">Overdue Bills</div>
                <div class="bp-stat-value">@Model.Count(b => b.DueAmount > 0)</div>
                <div class="bp-stat-sub">@((Model.Count() == 0) ? "0%" : String.Format("{0:0.##}%", Model.Count(b => b.DueAmount > 0) * 100.0 / Model.Count()))</div>
            </div>
        </div>

        <div class="bp-card bp-stat-card">
            <div class="bp-stat-icon purple"><i class="fa-solid fa-indian-rupee-sign"></i></div>
            <div>
                <div class="bp-stat-label">Total Revenue</div>
                <div class="bp-stat-value">₹@String.Format("{0:N2}", Model.Sum(b => b.TotalAmount))</div>
                <div class="bp-stat-sub">All Time</div>
            </div>
        </div>
    </div>

    <!-- ===================== MAIN CONTENT ===================== -->
    <div class="bp-main-row">

        <!-- LEFT COLUMN 75% -->
        <div>
            <div class="bp-card bp-list-card">
                <div class="bp-list-card-head">
                    <h5>Billing List</h5>
                    <div class="bp-show-entries">
                        Show
                        <select id="showEntries">
                            <option>10</option>
                            <option selected>25</option>
                            <option>50</option>
                            <option>100</option>
                        </select>
                        entries
                    </div>
                </div>

                <div class="bp-table-wrap">
                    <table class="bp-table" id="billingTable">
                        <thead>
                            <tr>
                                <th>Invoice No</th>
                                <th>Guest Name</th>
                                <th>Room No</th>
                                <th>Bill Date</th>
                                <th>Amount (₹)</th>
                                <th>Payment Status</th>
                                <th>Bill Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var b in Model)
                                {
                                    <tr>
                                        <td class="bp-invoice-no">@b.BillNumber</td>
                                        <td>
                                            <div class="bp-guest">
                                                <div class="bp-guest-avatar">@((b.CustomerName ?? string.Empty).Split(' ').Select(x => x.FirstOrDefault()).Where(x => x != '\0').Take(2).Aggregate(string.Empty, (a, c) => a + c))</div>
                                                <span class="bp-guest-name">@b.CustomerName</span>
                                            </div>
                                        </td>
                                        <td>@b.RoomNumber</td>
                                        <td>@b.BillDate.ToString("dd/MM/yyyy")</td>
                                        <td class="bp-amount">₹@String.Format("{0:N2}", b.TotalAmount)</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(b.PaymentStatus) && b.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="bp-badge bp-badge-paid">Paid</span>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(b.PaymentStatus) && b.PaymentStatus.Equals("Partial", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="bp-badge bp-badge-partial">Partial</span>
                                            }
                                            else
                                            {
                                                <span class="bp-badge bp-badge-pending">@b.PaymentStatus</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="bp-badge @(b.BillStatus == "Completed" ? "bp-badge-completed" : b.BillStatus == "Checked Out" ? "bp-badge-checkedout" : "bp-badge-due")">@b.BillStatus</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="bp-action-group justify-content-end">
                                                <a class="bp-icon-btn" title="View" href="@Url.Action("Details", "Billing", new { id = b.Id })"><i class="fa-solid fa-eye"></i></a>
                                                <button type="button" class="bp-icon-btn bp-print-row" data-bill-id="@b.Id" title="Print"><i class="fa-solid fa-print"></i></button>
                                                <button type="button" class="bp-icon-btn" title="More"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="8" class="bp-empty-state">No billing records found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="bp-table-footer">
                    <div class="bp-rows-per-page">
                        Rows per page
                        <select id="rowsPerPage">
                            <option>10</option>
                            <option selected>25</option>
                            <option>50</option>
                        </select>
                    </div>

                    <ul class="bp-pagination">
                        @* Simple client-side pagination placeholders; wire up to real server-side paging once the controller supports page/pageSize query params *@
                        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">Next</a></li>
                    </ul>
                </div>
            </div>

            <!-- Quick Actions + Payment Methods now sit side-by-side below the Billing List -->
            <div class="bp-side-row" style="margin-top:20px;">
                <div class="bp-card bp-side-card">
                    <h6>Quick Actions</h6>
                    <div class="bp-quick-actions">
                        <button type="button" class="bp-quick-action-btn primary" id="qaNewBill">
                            <span class="bp-quick-action-icon"><i class="fa-solid fa-plus"></i></span>
                            New Bill
                        </button>
                        <button type="button" class="bp-quick-action-btn">
                            <span class="bp-quick-action-icon blue"><i class="fa-solid fa-calendar-day"></i></span>
                            Today's Bills
                        </button>
                        <button type="button" class="bp-quick-action-btn">
                            <span class="bp-quick-action-icon orange"><i class="fa-solid fa-hourglass-half"></i></span>
                            Due Bills
                        </button>
                        <button type="button" class="bp-quick-action-btn">
                            <span class="bp-quick-action-icon green"><i class="fa-solid fa-receipt"></i></span>
                            Receipts
                        </button>
                        <button type="button" class="bp-quick-action-btn">
                            <span class="bp-quick-action-icon purple"><i class="fa-solid fa-chart-column"></i></span>
                            Reports
                        </button>
                    </div>
                </div>

                <div class="bp-card bp-side-card">
                    <h6>Payment Methods</h6>
                    <div class="bp-payment-methods">
                        <div class="bp-payment-item">
                            <span class="bp-payment-icon green"><i class="fa-solid fa-money-bill-wave"></i></span>
                            <span class="bp-payment-name">Cash</span>
                        </div>
                        <div class="bp-payment-item">
                            <span class="bp-payment-icon purple"><i class="fa-solid fa-credit-card"></i></span>
                            <span class="bp-payment-name">Card</span>
                        </div>
                        <div class="bp-payment-item">
                            <span class="bp-payment-icon blue"><i class="fa-solid fa-mobile-screen-button"></i></span>
                            <span class="bp-payment-name">UPI</span>
                        </div>
                        <div class="bp-payment-item">
                            <span class="bp-payment-icon green"><i class="fa-solid fa-building-columns"></i></span>
                            <span class="bp-payment-name">Net Banking</span>
                        </div>
                        <div class="bp-payment-item">
                            <span class="bp-payment-icon red"><i class="fa-solid fa-wallet"></i></span>
                            <span class="bp-payment-name">Wallet</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN 25% -->
        <div>
            <!-- Bill Summary (aggregated from the real billing list, not static dummy figures) -->
            <div class="bp-card bp-side-card" style="margin-bottom:0;">
                <h6>Bill Summary</h6>

                <div class="bp-summary-row">
                    <span>Total Bills</span>
                    <span class="bp-val">@(Model?.Count() ?? 0)</span>
                </div>
                <div class="bp-summary-row">
                    <span>Total Billed</span>
                    <span class="bp-val">₹@String.Format("{0:N2}", totalAmountSum)</span>
                </div>

                <hr class="bp-divider">

                <div class="bp-total-row">
                    <span class="bp-total-label">Total Amount</span>
                    <span class="bp-total-value">₹@String.Format("{0:N2}", totalAmountSum)</span>
                </div>

                <div class="bp-paid-due">
                    <div class="bp-mini-box paid">
                        <div class="bp-mini-label">Paid</div>
                        <div class="bp-mini-value">₹@String.Format("{0:N2}", paidAmountSum)</div>
                    </div>
                    <div class="bp-mini-box due">
                        <div class="bp-mini-label">Due</div>
                        <div class="bp-mini-value">₹@String.Format("{0:N2}", dueAmountSum)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        var btnPrint = document.getElementById('btnPrint');
        if (btnPrint) {
            btnPrint.addEventListener('click', function () {
                window.print();
            });
        }

        // ---- Export billing list as CSV ----
        function csvEscape(value) {
            var str = (value === null || value === undefined) ? '' : String(value);
            str = str.replace(/\s+/g, ' ').trim();
            if (str.indexOf(',') !== -1 || str.indexOf('"') !== -1 || str.indexOf('\n') !== -1) {
                str = '"' + str.replace(/"/g, '""') + '"';
            }
            return str;
        }

        function exportBillingCsv() {
            var table = document.getElementById('billingTable');
            if (!table) return;

            var rows = [];

            // Header row (skip the Action column, last th)
            var headerCells = table.querySelectorAll('thead th');
            var headerRow = [];
            headerCells.forEach(function (th, idx) {
                if (idx === headerCells.length - 1) return; // skip Action column
                headerRow.push(csvEscape(th.textContent));
            });
            rows.push(headerRow.join(','));

            // Body rows
            var bodyRows = table.querySelectorAll('tbody tr');
            bodyRows.forEach(function (tr) {
                var cells = tr.querySelectorAll('td');
                if (cells.length === 0) return;
                // Skip the "no records" placeholder row
                if (cells.length === 1 && cells[0].hasAttribute('colspan')) return;

                var rowData = [];
                cells.forEach(function (td, idx) {
                    if (idx === cells.length - 1) return; // skip Action column
                    rowData.push(csvEscape(td.textContent));
                });
                rows.push(rowData.join(','));
            });

            if (rows.length <= 1) {
                console.log('No billing records available to export.');
                return;
            }

            var csvContent = rows.join('\r\n');
            var blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);

            var link = document.createElement('a');
            var stamp = new Date().toISOString().slice(0, 10);
            link.href = url;
            link.setAttribute('download', 'billing-list-' + stamp + '.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        var btnExport = document.getElementById('btnExport');
        if (btnExport) {
            btnExport.addEventListener('click', exportBillingCsv);
        }

        var btnNewBill = document.getElementById('btnNewBill');
        if (btnNewBill) {
            btnNewBill.addEventListener('click', function () {
                window.location.href = '@Url.Action("Create", "Billing")';
            });
        }

        var qaNewBill = document.getElementById('qaNewBill');
        if (qaNewBill) {
            qaNewBill.addEventListener('click', function () {
                window.location.href = '@Url.Action("Create", "Billing")';
            });
        }

        var btnReset = document.getElementById('btnReset');
        if (btnReset) {
            btnReset.addEventListener('click', function () {
                var filterCard = document.querySelector('.bp-filter-card');
                if (!filterCard) return;
                filterCard.querySelectorAll('input').forEach(function (el) { el.value = ''; });
                filterCard.querySelectorAll('select').forEach(function (el) { el.selectedIndex = 0; });
            });
        }

        var btnSearch = document.getElementById('btnSearch');
        if (btnSearch) {
            btnSearch.addEventListener('click', function () {
                console.log('Search billing records with current filters');
            });
        }

        // Row action buttons (View / Print / More)
        // View and More actions already have links — wire Print to download/print the invoice
        document.querySelectorAll('.bp-print-row').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-bill-id');
                if (!id) return;
                // Option A: open the PDF download
                var url = '@Url.Action("DownloadPdf", "Billing")'.replace('?','').split('?')[0] + '/' + id;
                // Open in new tab to let user save or view
                window.open(url, '_blank');
            });
        });

        // Pagination click handling (visual state only)
        document.querySelectorAll('.bp-pagination .page-item:not(.disabled) .page-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var text = link.textContent.trim();
                if (text === 'Next' || text === 'Previous') { return; }
                document.querySelectorAll('.bp-pagination .page-item').forEach(function (item) {
                    item.classList.remove('active');
                });
                link.closest('.page-item').classList.add('active');
            });
        });
    })();
</script>
