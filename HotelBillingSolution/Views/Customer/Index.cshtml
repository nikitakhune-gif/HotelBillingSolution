            border-color: transparent;
            color: #fff;
            box-shadow: 0 6px 14px rgba(37, 99, 235, 0.4);
        }

        .cust-pagination-premium .page-item.disabled .page-link {
            opacity: 0.35;
            pointer-events: none;
