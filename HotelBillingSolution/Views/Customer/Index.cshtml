<script>
    (function () {
        "use strict";

        document.addEventListener("DOMContentLoaded", initCustomersPage);

        function initCustomersPage() {
            const table = document.getElementById("customersTable");
            if (!table) return;

            const tbody = document.getElementById("customersTableBody");
            const rows = () => Array.from(tbody.querySelectorAll("tr"));

            const searchInput = document.getElementById("custSearch");
            const quickSearchInput = document.getElementById("tableQuickSearch");
            const typeSelect = document.getElementById("filterCustomerType");
            const statusSelect = document.getElementById("filterStatus");
            const citySelect = document.getElementById("filterCity");
            const countrySelect = document.getElementById("filterCountry");
            const resetBtn = document.getElementById("btnResetFilter");
            const searchBtn = document.getElementById("btnSearchFilter");
            const countLabel = document.getElementById("customersCountLabel");
            const sortableHeaders = table.querySelectorAll("th.sortable");

            let sortState = { key: null, dir: 1 };

            // ---------- FILTERING ----------
            function applyFilters() {
                const term = ((searchInput && searchInput.value) || (quickSearchInput && quickSearchInput.value) || "")
                    .trim()
                    .toLowerCase();
                const type = typeSelect ? typeSelect.value : "";
                const status = statusSelect ? statusSelect.value : "";
                const city = citySelect ? citySelect.value : "";
                const country = countrySelect ? countrySelect.value : "";

                let visibleCount = 0;

                rows().forEach((row) => {
                    const custType = row.dataset.type || "";
                    const custStatus = row.dataset.status || "";
                    const custCity = row.dataset.city || "";
                    const custCountry = row.dataset.country || "";
                    const rowText = row.textContent.toLowerCase();

                    let visible = true;

                    if (term && !rowText.includes(term)) visible = false;
                    if (type && custType !== type) visible = false;
                    if (status && custStatus !== status) visible = false;
                    if (city && custCity !== city) visible = false;
                    if (country && custCountry !== country) visible = false;

                    row.style.display = visible ? "" : "none";
                    if (visible) visibleCount++;
                });

                updateCountLabel(visibleCount);
            }

            function updateCountLabel(visibleCount) {
                if (!countLabel) return;
                const total = rows().length;
                const shown = Math.min(visibleCount, total);
                countLabel.textContent = `Showing ${shown === 0 ? 0 : 1} to ${shown} of 520 Customers`;
            }

            function resetFilters() {
                if (searchInput) searchInput.value = "";
                if (quickSearchInput) quickSearchInput.value = "";
                if (typeSelect) typeSelect.value = "";
                if (statusSelect) statusSelect.value = "";
                if (citySelect) citySelect.value = "";
                if (countrySelect) countrySelect.value = "";
                applyFilters();
            }

            if (searchInput) searchInput.addEventListener("input", debounce(applyFilters, 200));
            if (quickSearchInput) quickSearchInput.addEventListener("input", debounce(applyFilters, 200));
            [typeSelect, statusSelect, citySelect, countrySelect].forEach((el) => {
                if (el) el.addEventListener("change", applyFilters);
            });
            if (resetBtn) resetBtn.addEventListener("click", resetFilters);
            if (searchBtn) searchBtn.addEventListener("click", applyFilters);

            // ---------- SORTING ----------
            sortableHeaders.forEach((th) => {
                th.addEventListener("click", () => {
                    const key = th.dataset.sort;
                    sortState.dir = sortState.key === key ? sortState.dir * -1 : 1;
                    sortState.key = key;

                    sortableHeaders.forEach((h) => h.querySelector("i").className = "fa-solid fa-sort");
                    const icon = th.querySelector("i");
                    icon.className = sortState.dir === 1 ? "fa-solid fa-sort-up" : "fa-solid fa-sort-down";

                    sortRows(key, sortState.dir);
                });
            });

            function sortRows(key, dir) {
                const map = {
                    customerId: (r) => r.dataset.customerId,
                    name: (r) => r.dataset.name.toLowerCase(),
                    city: (r) => r.dataset.city,
                    bookings: (r) => Number(r.dataset.bookings),
                    spending: (r) => Number(r.dataset.spending),
                    registered: (r) => new Date(r.children[11].textContent.trim())
                };
                const getValue = map[key];
                if (!getValue) return;

                const sorted = rows().sort((a, b) => {
                    const va = getValue(a);
                    const vb = getValue(b);
                    if (va < vb) return -1 * dir;
                    if (va > vb) return 1 * dir;
                    return 0;
                });

                sorted.forEach((row) => tbody.appendChild(row));
            }

            // ---------- PAGINATION (demo only) ----------
            const pagination = document.getElementById("customersPagination");
            if (pagination) {
                pagination.addEventListener("click", (e) => {
                    const link = e.target.closest(".page-link");
                    if (!link) return;
                    e.preventDefault();

                    const items = Array.from(pagination.querySelectorAll(".page-item"));
                    items.forEach((li) => li.classList.remove("active"));
                    const parentLi = link.closest(".page-item");
                    if (parentLi && link.dataset.page !== "prev" && link.dataset.page !== "next") {
                        parentLi.classList.add("active");
                    }
                    // Real implementation: fetch page data via AJAX from CustomersController
                    // and re-render tbody + countLabel accordingly.
                });
            }

            // ---------- ROWS PER PAGE ----------
            const rowsPerPage = document.getElementById("rowsPerPage");
            if (rowsPerPage) {
                rowsPerPage.addEventListener("change", () => {
                    applyFilters();
                });
            }

            // ---------- UTIL ----------
            function debounce(fn, delay) {
                let timer;
                return function (...args) {
                    clearTimeout(timer);
                    timer = setTimeout(() => fn.apply(this, args), delay);
                };
            }

            updateCountLabel(rows().length);

            // Import file handling: auto-submit when file selected
            const importFileInput = document.getElementById('importFileInput');
            const importForm = document.getElementById('importForm');
            if (importFileInput && importForm) {
                importFileInput.addEventListener('change', function () {
                    if (importFileInput.files && importFileInput.files.length > 0) {
                        importForm.submit();
                    }
                });
            }
        }
    })();
</script>
